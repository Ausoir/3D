[gd_scene load_steps=3 format=2]

[sub_resource type="GDScript" id=1]
script/source = "extends OmniLight

func _ready():
	$AnimationPlayer.play(\"Flash\")

func set_flash(speed, dist, energy):
	$AnimationPlayer.set_speed_scale(speed)
	var flash = $AnimationPlayer.get_animation(\"Flash\")
	flash.track_set_key_value(0, 1, dist)
	flash.track_set_key_value(1, 1, energy)
"

