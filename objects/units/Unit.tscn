script/source = "extends KinematicBody

const GRAVITY = -40 #Stuttering at -40
const JUMP_SPEED = 20
const HEIGHT = Vector3(0, 16, 0)
const state_map = {
	\"fall\": 4,
	\"grab\": 1,
	\"work\": 2,
	\"jump\": 3,
	\"move\": 0,
	\"attack\": 6,
}
const hardstate_map = {
	\"death\": 1,
	\"drop\": 2,
	\"hit\": 3,
	\"knockdown\": 4,
}
const skin_map = {
	\"skin\": 0, \"eyes\": 1, \"mouth\": 2, \"armor\": 3, \"arms\": 4, \"legs\": 5
}
onready var sfx_land = $Sound/Land
onready var sfx_step = $Sound/Step
onready var anim_tree = $AnimationTree
onready var anim_player = $AnimationPlayer
onready var skeleton = $CharacterArmature/Skeleton
onready var body_mesh = $CharacterArmature/Skeleton/Body
onready var health_bar = $Health
onready var damage_label = $Damage
var item_name = \"unit\"
var controller
var move_speed: = 6
var motion_target = Vector2()
var motion = Vector2()
var view_x = Vector3()
var view_z = Vector3()
var orientation = Transform()
var velocity = Vector3()
var prev_post_velocity = 0
var state = \"move\"
var state_time = 0
var state_lock = false
var status
var airborne_time = -2
var step_time = 0
var frame = 0
var hit_glance = false #hit bounces off object
var hitbox
var hitshape
var head
var hand
var weapon
var helm
var level = 1
var armors = {}
var health = Vector2(5, 5)


func _ready():
	status = G.factory.Status.new()
	orientation = global_transform
	orientation.origin = Vector3()
	head = skeleton.find_bone(\"Head\")
	hand = skeleton.find_bone(\"Fist.R\")
	hitshape = BoxShape.new()
	hitshape.extents = Vector3(.5, 2, .5)
	hitbox = PhysicsShapeQueryParameters.new()
	hitbox.set_shape(hitshape)
	hitbox.set_collision_mask(0b00000000000000000111)


func set_state(arg=\"move\", force=false):
	if !state_lock or force:
		if state != arg:
			if state == \"death\":
				state_lock = true
				set_collision_layer(0b00000000000000000000)
			else:
				state = arg
				if state in hardstate_map:
					state_lock = true
					anim_tree[\"parameters/hardstate/current\"] = hardstate_map[state]
				elif state == \"attack\":
					state_lock = true
					anim_tree[\"parameters/state/current\"] = state_map[state]
				else:
					anim_tree[\"parameters/hardstate/current\"] = 0
					anim_tree[\"parameters/state/current\"] = state_map[state]
		state_time = 0


func _physics_process(delta):
	status.update(delta)
	update_equipment()
	
	if is_on_floor():
		if airborne_time > .2:
			airborne_time = 0
			on_hit(get_position(), null, 1, [\"penetrate\"])
			set_state(\"drop\", true)
			sfx_land.play()
		else:
			airborne_time = 0
			if !state_lock:
				if motion_target == Vector2.ZERO and velocity == Vector3.ZERO and state == \"move\":
					return
				anim_tree[\"parameters/state/current\"] = state_map[state]
			elif state == \"drop\":
				motion_target *= 0
			elif state == \"hit\":
				motion_target *= 0
			elif state == \"attack\":
				if state_time > .2 and state_time < .5:
					motion_target *= 1.5
				elif state_time > .8:
					motion_target *= .4
			elif state == \"death\":
				motion_target *= 0
				var mat_override = body_mesh.get_material_override()
				if mat_override == null:
					var mat = SpatialMaterial.new()
					mat.albedo_color = Color(.2,0,.3,1)
					mat.flags_transparent = true
					body_mesh.set_material_override(mat)
				elif mat_override.albedo_color.a > 0:
					mat_override.albedo_color.a -= .002
				else:
					die()
			state_time += delta
	elif velocity.y < GRAVITY * .15:
		airborne_time += delta
		if airborne_time > .1:
			set_state(\"fall\")
			if get_position().y < -5:
				damage(1)
				return
	else:
		motion_target *= 0
	motion = motion.linear_interpolate(motion_target, 8 * delta)
	var speed = max(abs(motion.x), abs(motion.y))
	var target = motion.x * view_x + motion.y * view_z
	if speed > 0.1:
		var q_from = orientation.basis.get_rotation_quat()
		var q_to = Transform().looking_at(target, Vector3.UP).basis.get_rotation_quat()
		# Interpolate current rotation with desired one.
		orientation.basis = Basis(q_from.slerp(q_to, delta * 10))
		step_time += speed
		if step_time > 30 and is_on_floor():
			step_time = 0
			sfx_step.seek(0)
			sfx_step.play()
	var rotdiff = orientation.basis.x.dot(view_z)
	anim_tree[\"parameters/head_h/add_amount\"] = rotdiff * -2
	#var root_motion = anim_tree.get_root_motion_transform()
	#orientation *= root_motion
	#var root_velocity = orientation.origin / delta
	var h_velocity = Vector2(0, move_speed*speed).rotated(-orientation.basis.get_euler().y)
	velocity.x = h_velocity.x# + root_velocity.x
	velocity.z = h_velocity.y# + root_velocity.z
	velocity.y += GRAVITY * delta
	velocity = move_and_slide(velocity, Vector3.UP, true)
	var post_velocity = Vector2(velocity.x, velocity.z).length() / move_speed
	post_velocity = prev_post_velocity + (post_velocity - prev_post_velocity) * .1
	anim_tree[\"parameters/lunge/blend_amount\"] = post_velocity
	anim_tree[\"parameters/movement/blend_position\"] = post_velocity
	prev_post_velocity = post_velocity

	#orientation.origin = Vector3() # Clear accumulated root motion displacement (was applied to speed).
	orientation = orientation.orthonormalized() # Orthonormalize orientation.

	global_transform.basis = orientation.basis


func on_anim_finish():
	state_lock = false
	get_parent().task_timer = 0
	set_state()


func update_equipment():
	if helm:
		helm.transform = skeleton.get_bone_global_pose(head)
	if weapon:
		var hand_form = skeleton.get_bone_global_pose(hand)
		var hand_pos = hand_form.translated(Vector3(0, .2, 0)).origin
		weapon.transform.basis.y = hand_form.basis.z
		weapon.transform.basis.z = hand_form.basis.y
		weapon.transform.basis.x = hand_form.basis.x
		weapon.orthonormalize()
		weapon.transform.origin = hand_pos

func set_weapon(item):
	if !weapon and item != null:
		G.rid(item, false)
		add_child(item)
		weapon = item
		weapon.holder = self
		#weapon_tip = item.get_aabb().end.y / 2
		if \"speed\" in weapon.properties:
			anim_tree[\"parameters/attack speed/scale\"] = weapon.properties.speed
		else:
			anim_tree[\"parameters/attack speed/scale\"] = 1
	elif weapon and item == null:
		weapon.holder = null
		remove_child(weapon)
		weapon.transform.origin = get_position() + skeleton.get_bone_global_pose(hand).rotated(Vector3.UP, orientation.basis.get_euler().y).origin
		G.world.objects.add_child(weapon)
		G.drop(weapon, [self, weapon])
		weapon = null


func set_armor(arg):
	var data = arg.properties
	if data.part in armors:
		var oldarmor = armors[data.part]
		remove_child(oldarmor)
		G.world.objects.add_child(oldarmor)
		oldarmor.transform.origin = get_position()
		if \"health\" in oldarmor.properties:
			health.x -= oldarmor.properties.health
			health.y -= oldarmor.properties.health
	if arg.holder == self:
		set_weapon(null)
	G.rid(arg, false)
	if data.part == \"head\":
		add_child(arg)
		helm = arg
	else:
		body_mesh.set_surface_material(skin_map[data.part], data.skin)
	armors[data.part] = arg
	if \"health\" in data:
		health.x += data.health
		health.y += data.health
	health.x = max(1, health.x)


func on_hit(pos, hitter, damage, tags):
	if !(\"penetrate\" in tags):
		var hit_part = G.rng.randi_range(1, 10)
		var armor
		if hit_part <= 2 and \"arms\" in armors:
			armor = armors.arms
		elif hit_part <= 4 and \"legs\" in armors:
			armor = armors.legs
		elif hit_part == 5 and \"head\" in armors:
			armor = armors.head
		elif \"armor\" in armors:
			armor = armors.armor
		if armor:
			if \"defense\" in armor.properties:
				damage -= G.roll(armor.properties.defense)
	if hitter:
		controller.on_hit(pos, hitter, damage)
	if damage <= 0:
		G.make_particle(\"spark\", pos, 1)
	else:
		damage_label.display(damage)
		G.make_particle(\"blood\", pos, 1)
		set_state(\"hit\", true)
		damage(damage)
		health_bar.display(health.x, health.y, item_name, level)


func on_attack():
	var weapon_damage = 0
	var weapon_tags = []
	if weapon == null:
		var hand_pos = skeleton.get_bone_global_pose(hand).origin
		hitbox.set_transform(Transform().translated(hand_pos))
	else:
		#var hand_pos = weapon.transform.basis.y * weapon_tip
		hitbox.set_exclude([self, weapon])
		hitbox.set_transform(weapon.global_transform)
		#$MeshInstance.transform = weapon.transform.translated(hand_pos)
		if \"damage\" in weapon.properties:
			weapon_damage = G.roll(weapon.properties.damage)
		if \"tags\" in weapon.properties:
			weapon_tags = weapon.properties.tags
	var hitpos = hitbox.get_transform().origin
	var r = G.space.intersect_shape(hitbox, 4)
	var victim
	if r:
		if r[0].collider is GridMap:
			var tileobject = G.world.get_object_at(hitpos)
			if tileobject == \"tree\" and \"chop\" in weapon_tags:
				G.make_particle(\"dust\", hitpos, 1)
				G.world.set_object_at(hitpos, \"stump\")
			elif tileobject == \"palm\" and \"chop\" in weapon_tags:
				G.make_particle(\"dust\", hitpos, 1)
				G.world.set_object_at(hitpos, \"stump\")
			elif tileobject == \"stump\" and \"chop\" in weapon_tags:
				G.make_particle(\"dust\", hitpos, 1)
				G.world.set_object_at(hitpos, null)
			elif (tileobject == \"rock\" or tileobject == \"rocks\") and \"mine\" in weapon_tags:
				G.make_particle(\"dust\", hitpos, 1)
				G.world.set_object_at(hitpos, null)
			elif tileobject == \"mineral\" and \"mine\" in weapon_tags:
				G.make_particle(\"dust\", hitpos, 1)
			if hit_glance:
				G.make_particle(\"spark\", hitpos, 1)
				set_state(\"hit\", true)
				return
		elif r[0].collider is KinematicBody:
			victim = r[0].collider
		else:
			if r[0].collider.get_parent().get(\"health\"):
				if \"demolish\" in weapon_tags:
					r[0].collider.get_parent().on_hit(hitpos, self, weapon_damage, weapon_tags)
					return
			if hit_glance:
				G.make_particle(\"spark\", hitpos, 1)
				set_state(\"hit\", true)
				return
	else: #if obj doesnt have collision shapes
		var tileobject = G.world.get_object_at(hitpos)
		if (tileobject == \"weed\" or tileobject == \"flower\") and \"cut\" in weapon_tags:
			G.make_particle(\"dust\", hitpos, 1)
			G.world.set_object_at(hitpos, null)
	if victim:
		victim.on_hit(hitpos, self, weapon_damage, weapon_tags)


func get_view_position():
	return skeleton.get_bone_global_pose(head).origin + global_transform.origin


func get_position():
	return global_transform.origin


func get_interact_position():
	return global_transform.origin + Vector3.UP


func get_adjacent(x, y):
	var h = Vector2(x, y).rotated(-transform.basis.get_euler().y)
	var pos = get_position()
	var target_pos = Vector3(pos.x + h.x, pos.y, pos.z + h.y)
	return target_pos


func get_team():
	return G.factions[get_parent().faction]


func damage(dmg):
	if health.x > 0:
		health.x -= dmg
		if health.x <= 0:
			get_parent().set_task()
			set_state(\"death\", true)


func die():
	status.die()
	if weapon:
		weapon.die()
	controller.die()
"

