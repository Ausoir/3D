[gd_scene load_steps=3 format=2]

[ext_resource path="res://objects/units/Pilot.tscn" type="PackedScene" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

onready var pilot = $Pilot
onready var unit = $Pilot/Unit
var item_type = \"unit\"
var rng = RandomNumberGenerator.new()
var world
var target
var state = \"idle\"
var sight_range = 12
var attack_range = 5
var frame = 0
var last_pos

var Pathing = preload(\"res://objects/units/Pathing.gd\")
var pathing


func _ready():
	world = G.world
	pathing = Pathing.new(world)
	last_pos = unit.get_position()
	unit.controller = self


func set_faction(faction):
	$Pilot.faction = faction


func update_target(has_target, thought=false):
	if !has_target:
		return
	var unit_pos = unit.get_interact_position()
	var target_pos = target.get_interact_position()
	if not reach_to(unit_pos, target_pos):
		path_to(len(pilot.tasks) == 0 or thought, unit_pos, target_pos)


func reach_to(unit_pos, target_pos):
	var collision = G.space.intersect_ray(unit_pos, target_pos, [], 0b00000000000000100101)
	if not collision and abs(unit_pos.y - target_pos.y) < 2:
		var dir = unit_pos.direction_to(target_pos)
		dir.y = 0
		var front = unit_pos + dir
		var land_collision = G.space.intersect_ray(front, unit_pos+(dir*3)+Vector3(1.5,-6,0), [unit])
		if land_collision and abs(unit.get_position().y - land_collision.position.y) < .2:
			land_collision = G.space.intersect_ray(front, unit_pos+(dir*3)+Vector3(-1.5,-6,0), [unit])
			if land_collision and abs(unit.get_position().y - land_collision.position.y) < .2:
				land_collision = G.space.intersect_ray(front, unit_pos+(dir*3)+Vector3(0,-6,-1.5), [unit])
				if land_collision and abs(unit.get_position().y - land_collision.position.y) < .2:
					land_collision = G.space.intersect_ray(front, unit_pos+(dir*3)+Vector3(0,-6,1.5), [unit])
					if land_collision and abs(unit.get_position().y - land_collision.position.y) < .2:
						state = \"hunt\"
						pilot.set_task([\"move\", 9999, target_pos, 0])
						return true
		pilot.set_task()


func path_to(repath, from, to):
	var path
	if repath:
		pathing.result = []
		path = pathing.update(from, to)
	else:
		path = pathing.update_nodes(from)
	if path:
		state = \"path\"
		pilot.set_task([\"idle\", 0])
		for p in path:
			pilot.add_task([\"move\", 9999, p, 1.4])
		pilot.next_task()


func unstuck():
	state = \"stuck\"
	var unit_pos = unit.get_interact_position()
	var target_pos = target.get_interact_position()
	var collision = G.space.intersect_ray(unit_pos, target_pos, [unit, target], 32)
	if collision and is_instance_valid(collision.collider) and (collision.collider is StaticBody or collision.collider is KinematicBody):
		var col_faction = collision.collider.get_parent().get(\"faction\")
		if collision and col_faction and !pilot.get_team().is_ally(col_faction):
			pilot.set_task([\"attack\", 9999, collision.position])
			return
	var building = G.world.get_item_type_at(\"building\", unit.get_interact_position(), 6)
	if building:
		pilot.set_task([\"attack\", 9999, building.global_transform.origin])
	else:
		var strafe = unit_pos.cross(target_pos) * (40 * rng.randi_range(0, 1) - 20)
		pilot.set_task([\"move\", rng.randi_range(20, 40), unit_pos + strafe, 0])


func perceive():
	for obj in G.world.units.get_children():
		if obj != self:
			var objpos = obj.unit.get_view_position()
			var unitpos = unit.get_view_position()
			var dist = unitpos.distance_to(objpos)
			if dist < sight_range and !obj.pilot.get_team().is_ally(pilot.faction) and\\
				unitpos.direction_to(objpos).dot(unit.transform.basis.z) > 0:
				var collision = G.space.intersect_ray(unitpos, objpos, [unit, obj.unit], 32)
				if not collision:
					target = obj.unit


func hear(vec):
	if !target or !is_instance_valid(target):
		var unit_pos = unit.get_interact_position()
		if not reach_to(unit_pos, vec):
			path_to(true, unit_pos, vec)


func on_hit(_pos, hitter, _damage):
	target = hitter


func die():
	unit.status.die()
	unit.queue_free()
	queue_free()


func _physics_process(_delta):
	if unit.state != \"death\":
		frame += 1
		var has_target = false
		if target:
			if is_instance_valid(target):
				has_target = true
				if state == \"hunt\": #autoaim
					var target_pos = target.get_position()
					if pilot.task[0] == \"move\":
						if (target_pos - unit.get_position()).length() < attack_range:
							pilot.set_task([\"attack\", 9999, target_pos])
						else:
							pilot.task[2] = target_pos
					elif pilot.task[0] == \"attack\":
						pilot.task[2] = target_pos
			else:
				target = null
		if frame % 20 == 0:
			if frame % 120 == 0:
				if frame >= 240 or !has_target:
					frame = 0
					perceive()
					update_target(has_target, true)
				elif has_target:
					var new_pos = unit.get_position()
					if (new_pos - last_pos).length() < 2:
						unstuck()
					last_pos = new_pos
			elif state == \"stuck\":
				if (unit.get_position() - last_pos).length() > 2:
					state = \"idle\"
			else:
				update_target(has_target, false)
"

[node name="Npc" type="Spatial"]
script = SubResource( 1 )

[node name="Pilot" parent="." instance=ExtResource( 1 )]
