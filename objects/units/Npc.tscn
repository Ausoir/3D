[gd_scene load_steps=3 format=2]

[ext_resource path="res://objects/units/Pilot.tscn" type="PackedScene" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

onready var pilot = $Pilot
onready var unit = $Pilot/Unit
var rng = RandomNumberGenerator.new()

var world
var target
var state = \"idle\"
var sight_range = 800
var faction = 2
var frame = 0

var Pathing = load(\"res://objects/units/Pathing.gd\")
var pathing


func _ready():
	world = G.world
	pathing = Pathing.new()
	target = G.younit


func update_target():
	if target != null:
		var unit_pos = unit.get_position() + Vector3.UP
		var target_pos = target.get_position() + Vector3.UP
		var collision = G.space.intersect_ray(unit_pos, target_pos, [unit, target], 32)
		if not collision and abs(unit_pos.y - target_pos.y) < 5:
			collision = G.space.intersect_ray(unit_pos, target_pos, [unit, target], 1)
			if collision:
				state = \"idle\"
				var strafe = unit_pos.cross(target_pos) * (40 * rng.randi_range(0, 1) - 20)
				pilot.set_task([\"move\", rng.randi_range(20, 40), unit_pos + strafe, 0])
				pilot.add_task([\"move\", -1, target_pos, 1])
				pilot.add_task([\"attack\", -1, target_pos])
			else:
				state = \"hunt\"
				pilot.set_task([\"move\", -1, target_pos, 0])
		else:
			if collision:
				var col_faction = collision.collider.get(\"faction\")
				if collision and col_faction and col_faction != faction:
					state = \"hunt\"
					pilot.set_task([\"attack\", -1, collision.position])
					return
			if G.world.get_tile_at(unit_pos + Vector3(0,-3,0)) != G.world.tilemap.hillslope:
				var path = pathing.update(unit_pos, target_pos)
				if path:
					state = \"path\"
					pilot.set_task([\"idle\", 0])
					for p in path:
						pilot.add_task([\"move\", -1, p, 1])
				else:
					unit.motion_target = Vector2()
					pilot.set_task()
					state = \"idle\"
	else:
		state = \"idle\"


func find_player(playerunit):
	var collision = G.check_collision(unit.get_position(), playerunit.get_position(), [unit])
	if collision and collision.collider == playerunit:
		var dist = unit.get_position().distance_to(playerunit.get_position())
		if dist < sight_range:
			target = playerunit


func _physics_process(_delta):
	if state == \"hunt\":
		var target_pos = target.get_position()
		if pilot.task[0] == \"move\":
			if (target_pos - unit.get_position()).length() < 4:
				pilot.set_task([\"attack\", 40, target_pos])
			else:
				pilot.task[2] = target_pos
		elif pilot.task[0] == \"attack\":
			pilot.task[2] = target_pos
	frame += 1
	if frame >= 80:
		pathing.result = []
		frame = 0
		update_target()
"

[node name="Npc" type="Spatial"]
script = SubResource( 1 )

[node name="Pilot" parent="." instance=ExtResource( 1 )]

