script/source = "extends \"res://objects/units/Unit.gd\"


const state_map = {
	\"grab\": 1,
	\"work\": 2,
	\"jump\": 3,
	\"fall\": 4,
	\"special\": 5,
}
const hardstate_map = {
	\"death\": 1,
	\"drop\": 2,
	\"hit\": 3,
	\"knockdown\": 4,
}
const attack_map = {
	\"swing\": 1,
	\"flurry\": 2,
	\"whirlwind\": 3,
}
const skin_map = {
	\"skin\": 0, \"armor\": 1, \"arms\": 2, \"legs\": 3
}
const MAT_FACE = preload(\"res://assets/materials/mat_face.tres\")
const MAT_HAIR = preload(\"res://assets/materials/mat_hair.tres\")
const FACE_TEXTURES = [
	preload(\"res://assets/textures/character/1_face.png\"),
	preload(\"res://assets/textures/character/2_face.png\"),
	preload(\"res://assets/textures/character/3_face.png\"),
	preload(\"res://assets/textures/character/4_face.png\"),
]
const FACE_TEXTURES_MAD = [
	preload(\"res://assets/textures/character/1_face_mad.png\"),
	preload(\"res://assets/textures/character/2_face_mad.png\"),
	preload(\"res://assets/textures/character/3_face_mad.png\"),
	preload(\"res://assets/textures/character/4_face_mad.png\"),
]
const FACE_TEXTURES_SAD = [
	preload(\"res://assets/textures/character/1_face_sad.png\"),
	preload(\"res://assets/textures/character/2_face_sad.png\"),
	preload(\"res://assets/textures/character/3_face_sad.png\"),
	preload(\"res://assets/textures/character/4_face_sad.png\"),
]
const FACE_TEXTURES_PAIN = [
	preload(\"res://assets/textures/character/1_face_pain.png\"),
	preload(\"res://assets/textures/character/2_face_pain.png\"),
	preload(\"res://assets/textures/character/3_face_pain.png\"),
	preload(\"res://assets/textures/character/4_face_pain.png\"),
]
const FACES = [
	[[FACE_TEXTURES[0],FACE_TEXTURES[0],FACE_TEXTURES[0],FACE_TEXTURES[1]],
	 [FACE_TEXTURES_MAD[0]],
	 [FACE_TEXTURES_SAD[0]],
	 [FACE_TEXTURES_PAIN[0]]],
	[[FACE_TEXTURES[0],FACE_TEXTURES[0],FACE_TEXTURES[0],FACE_TEXTURES[1]],
	 [FACE_TEXTURES_MAD[0]],
	 [FACE_TEXTURES_SAD[0]],
	 [FACE_TEXTURES_PAIN[0]]],
]
const HAIRS = [
	preload(\"res://assets/textures/character/hair_1.png\"),
	preload(\"res://assets/textures/character/hair_2.png\"),
	preload(\"res://assets/textures/character/hair_3.png\"),
	preload(\"res://assets/textures/character/hair_4.png\"),
	preload(\"res://assets/textures/character/hair_5.png\"),
	preload(\"res://assets/textures/character/hair_6.png\"),
	preload(\"res://assets/textures/character/hair_7.png\"),
	preload(\"res://assets/textures/character/hair_8.png\"),
]
const skin = preload(\"res://assets/materials/mat_skin.tres\")
var hand
var handL
var weapon
var offhand
var helm
var armors = {}
var expressions
var gene = 0

func _ready():
	._ready()
	var _err = $Tween.connect(\"tween_all_completed\", self, \"on_tween_finish\")
	hand = skeleton.find_bone(\"Fist.R\")
	handL = skeleton.find_bone(\"Fist.L\")

func set_seed(p):
	if p == -1:
		p = G.rng.randi_range(0, 999999)
	gene = p
	seed(p)
	var size = randf()*.4 + .8
	unit_size = Vector3(size,size,size)
	expressions = FACES[p%len(FACES)]
	var unique_face = MAT_FACE.duplicate()
	unique_face.albedo_texture = unique_face.albedo_texture.duplicate()
	body_mesh.set_surface_material(4, unique_face)
	set_face(0)
	body_mesh.set_surface_material(5, MAT_HAIR.duplicate())
	body_mesh.get_surface_material(5).albedo_texture = HAIRS[p%7]
	var r = randf()
	var g = randf() * r
	var b = randf() * g
	body_mesh.get_surface_material(5).albedo_color = Color(r,g,b)

func set_face(p):
	var tex = body_mesh.get_surface_material(4).albedo_texture
	var texNum = len(expressions[p])
	tex.set_frames(texNum)
	for i in range(texNum):
		tex.set_frame_texture(i, expressions[p][i])

func set_state(arg=\"move\", force=false):
	if state != arg:
		if !state_lock or force:
			if state != \"death\":
				cast = min(cast, 0)
				if arg == \"move\":
					anim_tree[\"parameters/state/current\"] = 0
				elif arg in hardstate_map:
					state_lock = true
					anim_tree[\"parameters/hardstate/current\"] = hardstate_map[arg]
					if arg == \"death\":
						velocity *= 0
						set_collision_layer_bit(1, 0)
						set_collision_mask_bit(1, 0)
						set_face(3)
					elif arg == \"hit\":
						set_face(3)
				elif arg in attack_map:
					set_face(1)
					state_lock = true
					anim_tree[\"parameters/attack/current\"] = attack_map[arg]
					anim_tree[\"parameters/state/current\"] = 0
				else:
					anim_tree[\"parameters/state/current\"] = state_map[arg]
				state = arg
				state_time = 0

func on_cast():
	if cast >= 0:
		cast += 1

func on_anim_finish():
	if state != \"death\":
		if health.x / health.y < .5:
			set_face(2)
		else:
			set_face(0)
		state_lock = false
		controller.task_timer = 0
		anim_player.stop()
		anim_tree[\"parameters/hardstate/current\"] = 0
		if anim_tree[\"parameters/state/current\"] == 0:
			anim_tree[\"parameters/attack/current\"] = 0

func on_tween_finish():
	state_lock = false

func update_equipment():
	if helm:
		helm.global_transform = skeleton.global_transform * skeleton.get_bone_global_pose(head)
	if weapon:
		var hand_form = skeleton.get_bone_global_pose(hand)
		var hand_pos = skeleton.global_transform * hand_form.translated(Vector3(0,.2,0))
		weapon.transform.basis.y = hand_form.basis.z
		weapon.transform.basis.z = hand_form.basis.y
		weapon.transform.basis.x = hand_form.basis.x
		weapon.orthonormalize()
		weapon.global_transform.origin = hand_pos.origin
	if offhand:
		var hand_form = skeleton.get_bone_global_pose(handL)
		var hand_pos = skeleton.global_transform * hand_form.translated(Vector3(0,.2,0))
		offhand.transform.basis.y = hand_form.basis.z
		offhand.transform.basis.z = hand_form.basis.y
		offhand.transform.basis.x = hand_form.basis.x
		offhand.orthonormalize()
		offhand.global_transform.origin = hand_pos.origin

func set_weapon(item):
	if weapon and item == null:
		weapon.holder = null
		remove_child(weapon)
		weapon.transform.origin = get_position() + skeleton.get_bone_global_pose(hand).rotated(Vector3.UP, orientation.basis.get_euler().y).origin
		G.world.objects.add_child(weapon)
		G.drop(weapon, [self, weapon])
		var r = weapon
		weapon = null
		update_stats()
		anim_tree[\"parameters/cast type/current\"] = 1
		return r
	elif item != null:
		if weapon:
			set_weapon(null)
			if weapon == null:
				set_weapon(item)
		elif !weapon:
			G.rid(item, false)
			add_child(item)
			weapon = item
			weapon.holder = self
			hitshape = BoxShape.new()
			hitshape.extents = Vector3(.2, weapon.mesh.get_aabb().end.y - .3, .2)
			#$MeshInstance.mesh.size.y = hitshape.extents.y
			hitbox = PhysicsShapeQueryParameters.new()
			hitbox.set_shape(hitshape)
			hitbox.set_collision_mask(0b00000000000000000111)
			hitbox.set_exclude([self])
			update_stats()
		anim_tree[\"parameters/cast type/current\"] = 0
		return item

func get_reach():
	if weapon != null:
		return hitshape.extents.y + global_transform.basis.get_scale().x
	else:
		return global_transform.basis.get_scale().x

func unset_armor(part, update=true):
	if part in armors:
		var oldarmor = armors[part]
		if oldarmor.get_parent() == self:
			remove_child(oldarmor)
		G.world.objects.add_child(oldarmor)
		oldarmor.transform.origin = get_position()
		if update:
			armors.erase(part)
			if part == \"head\":
				helm = null
			elif part == \"offhand\":
				offhand = null
			elif part in skin_map:
				body_mesh.set_surface_material(skin_map[part], skin)
			update_stats()

func set_armor(arg):
	var data = arg.properties
	unset_armor(data.part, false)
	if arg.holder == self:
		set_weapon(null)
	G.rid(arg, false)
	if data.part == \"head\":
		add_child(arg)
		helm = arg
	elif data.part == \"offhand\":
		add_child(arg)
		offhand = arg
	elif data.part in skin_map:
		body_mesh.set_surface_material(skin_map[data.part], data.skin)
	armors[data.part] = arg
	update_stats()

func update_stats():
	var m_attack_speed = 0
	var m_cast_speed = 0
	var m_move_speed = 0
	var m_health = 5
	var m_strength = 0
	var m_defense = 0
	var m_focus = 0
	var equipments = armors.values()
	if weapon != null:
		equipments += [weapon]
	for item in equipments:
		if \"health\" in item.properties:
			m_health += item.properties.health
		if \"defense\" in item.properties:
			m_defense += item.properties.defense
		if \"speed\" in item.properties:
			m_attack_speed += item.properties.speed
		if \"weight\" in item.properties:
			var encumber = item.properties.weight - m_strength
			m_attack_speed -= encumber
			m_cast_speed -= encumber * 4
			m_move_speed -= encumber
		if \"focus\" in item.properties:
			m_focus += item.properties.focus
	if m_attack_speed > 0:
		anim_tree[\"parameters/attack speed/scale\"] = 1*(1+m_attack_speed*.1)
	else:
		anim_tree[\"parameters/attack speed/scale\"] = 1/(1-m_attack_speed*.1)
	if m_cast_speed > 0:
		anim_tree[\"parameters/cast speed/scale\"] = 1*(1+m_cast_speed*.1)
	else:
		anim_tree[\"parameters/cast speed/scale\"] = 1/(1-m_cast_speed*.1)
	if m_move_speed > 0:
		move_speed.y = 4 * (1+m_move_speed*.1)
	else:
		move_speed.y = 4 / (1-m_move_speed*.1)
	var healthPercent = health.x / health.y
	health.y = m_health
	health.x = floor(health.y * healthPercent)
	focus = m_focus
	return {
		\"health\": health,
		\"defense\": m_defense,
		\"move speed\": (move_speed * 10).round(),
		\"attack speed\": m_attack_speed,
		\"cast speed\": m_cast_speed,
		\"strength\": m_strength,
		\"focus\": m_focus,
	}

func get_defense():
	var ac = 0
	for v in armors.values():
		if \"defense\" in v.properties:
			ac += v.properties.defense
	return ac

func on_attack():
	if weapon != null:
		var weapon_damage = 0
		var weapon_tags = []
		var hit_transform = weapon.global_transform.translated(Vector3(0,hitshape.extents.y/2,0))
		hitbox.set_transform(hit_transform)
		#$MeshInstance.global_transform = hit_transform
		if \"damage\" in weapon.properties:
			weapon_damage = G.roll(weapon.properties.damage)
		if \"tags\" in weapon.properties:
			weapon_tags = weapon.properties.tags
		var r = G.space.intersect_shape(hitbox, 4)
		if r:
			for col in r:
				var victim = col.collider
				var hitstartpos = hitbox.get_transform()
				var hitpos = hitstartpos.translated(hitshape.extents).origin
				if victim is GridMap:
					if \"demolish\" in weapon_tags:
						if G.world.get_tile_at(hitpos) != -1:
							G.make_particle(\"dust\", hitpos, 1)
							G.world.set_tile_at(hitpos, -1, -1, true)
							set_weapon(null).die()
					return glance(hitstartpos.origin, weapon_tags)
				elif victim is KinematicBody:
					if victim.get(\"controller\") and controller.faction.is_ally(victim.controller.faction):
						set_state(\"hit\", true)
					else:
						victim.on_hit(hitpos, self, weapon_damage, weapon_tags)
				else:
					if victim.get_parent().get(\"health\"):
						victim.get_parent().on_hit(hitpos, self, weapon_damage, weapon_tags)
						return
					return glance(hitpos, weapon_tags)

func damage(dmg):
	.damage(dmg)
	if health.x > 0:
		anim_tree[\"parameters/limp/blend_amount\"] = 1 - (health.x / health.y)

func on_process(delta):
	move_speed.x = move_speed.y
	status.update(delta)
	update_equipment()
	if is_on_floor():
		if airborne_time > .6:
			airborne_time = 0
			set_state(\"drop\", true)
			sfx_land.play()
			G.cmds([[\"alert\", get_position(), 8]], self)
		else:
			airborne_time = 0
			if !state_lock:
				if state == \"move\":
					if motion_target == Vector2.ZERO and velocity == Vector3.ZERO:
						return
					else:
						anim_tree[\"parameters/lunge/blend_amount\"] *= .8
						motion_target *= .8
				else:
					motion_target *= 0
			elif state == \"drop\":
				motion_target *= 0
			elif state == \"hit\":
				motion_target *= 0
			elif state == \"death\":
				return dying(delta)
			else: #state in attack_map
				anim_tree[\"parameters/lunge/blend_amount\"] += (1-anim_tree[\"parameters/lunge/blend_amount\"])*.1
				if state == \"swing\":
					var atkspd = 1/anim_tree[\"parameters/attack speed/scale\"]
					motion_target *= .8
					if state_time > (.3 * atkspd) and state_time < (.7 * atkspd):
						move_speed.x = move_speed.y * 1.5
					elif state_time > (.7 * atkspd):
						motion_target *= .3
				else:
					motion_target *= 0
	else:
		if state == \"death\":
			return dying(delta)
		airborne_time += delta
		if airborne_time > .4:
			set_state(\"fall\")
			if get_position().y < 1:
				on_hit(get_position(), null, 4, [\"true\"])
	state_time += delta
	motion = motion.linear_interpolate(motion_target, 8 * delta)
	var speed = max(abs(motion.x), abs(motion.y))
	if speed > 0.1:
		face(delta, motion)
	var rotdiff = orientation.basis.x.dot(view_z)
	anim_tree[\"parameters/head_h/add_amount\"] = rotdiff * -2
	var h_velocity = Vector2(0, move_speed.x*speed).rotated(-orientation.basis.get_euler().y)
	velocity.x = h_velocity.x
	velocity.z = h_velocity.y
	velocity.y += GRAVITY
	velocity = move_and_slide(velocity, Vector3.UP)
	var post_velocity = Vector2(velocity.x, velocity.z).length() / move_speed.y
	post_velocity = prev_post_velocity + (post_velocity - prev_post_velocity) * .1
	anim_tree[\"parameters/movement/blend_position\"] = post_velocity
	prev_post_velocity = post_velocity
	push_objects(h_velocity)

	orientation = orientation.orthonormalized() # Orthonormalize orientation.
	global_transform.basis = orientation.basis.scaled(unit_size)

func get_hand_position():
	var hand_form = skeleton.get_bone_global_pose(hand)
	var hand_pos = skeleton.global_transform * hand_form.translated(Vector3(0,.2,0))
	return hand_pos.origin

func die():
	if weapon:
		weapon.die()
	for v in armors.values():
		v.die()
	.die()
"

