script/source = "extends Spatial

# Constants
const GRAVITY = Vector3()
const CAMERA_X_ROT_MIN = deg2rad(-75)
const CAMERA_X_ROT_MAX = deg2rad(40)

# Mouse sensitivity
export(float, 0.1, 1.0) var CAMERA_MOUSE_ROTATION_SPEED = 0.5

# Instances ref
onready var springarm = $CameraBase/SpringArm
onready var camera = $CameraBase
onready var pilot = $Pilot
onready var unit = $Pilot/Unit

# Variables (public members)
var mouse_motion = Vector2()
var mouse_captured = true
var item_type = \"unit\"
var target


func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	springarm.add_excluded_object(self)
	unit.controller = self
	unit.hit_glance = true
	G.factions[1].add(self)
	unit.item_name = \"inquisitor\"
	pilot.set_ability(\"debug\")


func set_faction(faction):
	pilot.faction = faction


func capture_mouse(mode = -1):
	if mouse_captured or mode == 0:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		mouse_captured = false
	elif !mouse_captured or mode == 1:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		mouse_captured = true


func _input(event):
	if mouse_captured:
		if event is InputEventMouseMotion:
			var rot = event.relative * CAMERA_MOUSE_ROTATION_SPEED
			camera.rotate_y(-rot.x)
			camera.orthonormalize()
			camera.rotation.x += rot.y
			camera.rotation.x = clamp(camera.rotation.x, CAMERA_X_ROT_MIN, CAMERA_X_ROT_MAX)
		show_interactable_tip()
			
	if Input.is_action_just_pressed(\"restart\"):
		print(\"Player._input:restart: \", get_tree().reload_current_scene())
	elif Input.is_action_just_pressed(\"ui_fullscreen\"):
		OS.window_fullscreen = !OS.window_fullscreen
	elif Input.is_action_just_pressed(\"ui_mouse\"):
		capture_mouse()


func _physics_process(_delta):
	var camera_basis = camera.global_transform.basis
	var camera_z = camera_basis.z
	var camera_x = camera_basis.x
	camera_z.y = 0
	camera_x.y = 0
	unit.view_z = camera_z.normalized()
	unit.view_x = camera_x.normalized()

	var unit_pos = unit.transform.origin
	var cam_pos = Vector2(unit_pos.x, unit_pos.z)
	camera.transform.origin.x = cam_pos.x
	camera.transform.origin.y = unit_pos.y+1.5
	camera.transform.origin.z = cam_pos.y
	unit.anim_tree[\"parameters/head_v/add_amount\"] = camera.rotation.x * 1.5

	var move_target = Vector2(
			Input.get_action_strength(\"move_right\") - Input.get_action_strength(\"move_left\"),
			Input.get_action_strength(\"move_back\") - Input.get_action_strength(\"move_front\")
		)
	if move_target != Vector2.ZERO:
		pilot.set_task([\"moveto\", .001, move_target.x, move_target.y])

	if mouse_captured:
		if Input.is_action_pressed(\"special\"):
			pilot.set_task([\"special\", 1])
		elif Input.is_action_just_pressed(\"interact\"):
			if G.ui.tooltip.visible:
				pilot.set_task([\"interact\", 0])
			else:
				pilot.swing(unit.weapon)
		elif Input.is_action_just_pressed(\"item\"):
			var pathing = Pathing.new(G.world)
			var pos = G.world.tilemap.world_to_map(unit.get_interact_position())
			G.message(\"Pos:\"+str(pos))
			G.message(str(pathing.get_routes(pos))+\" : \"+str(pos))
			G.message(\"Dir:\"+str(G.world.tilemap.get_cell_item_orientation(pos.x, pos.y, pos.z))+\" Item:\"+str(G.world.tilemap.get_cell_item(pos.x, pos.y, pos.z)))
			pilot.set_task([\"cmd\", 0, [[\"menu\", \"hand\"]], unit])


func show_interactable_tip():
	G.ui.set_tooltip(null)
	if camera.rotation.x > 0:
		var item = pilot.get_interactable()
		if item:
			if item.item_type == \"item\":
				G.ui.set_tooltip(\"Pick up [\" + item.item_name.capitalize() + \"]\")
			elif item.item_type == \"object\":
				G.ui.set_tooltip(\"Interact with [\" + item.item_name.capitalize() + \"]\")
			elif item.item_type == \"building\":
				G.ui.set_tooltip(\"Use [\" + item.item_name.capitalize() + \"]\")


func on_hit(_pos, _hitter, _damage):
	pass


func die():
	pass


func hear(_vec):
	pass
"

