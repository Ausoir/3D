script/source = "extends Spatial

# Constants
const GRAVITY = Vector3()
const CAMERA_X_ROT_MIN = deg2rad(-75)
const CAMERA_X_ROT_MAX = deg2rad(40)

# Mouse sensitivity
export(float, 0.1, 1.0) var CAMERA_MOUSE_ROTATION_SPEED = 0.5

# Instances ref
onready var springarm = $CameraBase/SpringArm
onready var camera = $CameraBase
onready var pilot = $Pilot
onready var unit = $Pilot/Unit
onready var ui = $Interface
onready var interaction_tip = $Interface/Interaction

# Variables (public members)
var mouse_motion = Vector2()
var mouse_captured = true


func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	springarm.add_excluded_object(self)
	var mat = load(\"res://assets/mat_dirt.tres\")
	unit.set_skin(3, mat)


func capture_mouse(mode = -1):
	if mouse_captured or mode == 0:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		mouse_captured = false
	elif !mouse_captured or mode == 1:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		mouse_captured = true


func _input(event):
	if mouse_captured:
		if event is InputEventMouseMotion:
			var rot = event.relative * CAMERA_MOUSE_ROTATION_SPEED
			camera.rotate_y(-rot.x)
			camera.orthonormalize()
			camera.rotation.x += rot.y
			camera.rotation.x = clamp(camera.rotation.x, CAMERA_X_ROT_MIN, CAMERA_X_ROT_MAX)
	if Input.is_action_just_pressed(\"restart\"):
		print(\"Player._input:restart: \", get_tree().reload_current_scene())
	elif Input.is_action_just_pressed(\"ui_fullscreen\"):
		OS.window_fullscreen = !OS.window_fullscreen
	elif Input.is_action_just_pressed(\"ui_mouse\"):
		capture_mouse()
	else:
		show_interactable_tip()


func _physics_process(_delta):
	unit.motion_target = Vector2(
			Input.get_action_strength(\"move_right\") - Input.get_action_strength(\"move_left\"),
			Input.get_action_strength(\"move_back\") - Input.get_action_strength(\"move_front\")
		)
	if unit.motion_target != Vector2.ZERO and unit.state != \"attack\":
		pilot.set_task()

	if mouse_captured:
		if Input.is_action_just_pressed(\"special\"):
			unit.set_state(\"jump\")
			unit.move_and_slide(unit.transform.basis.z*10, Vector3.UP)
			unit.velocity.y = 10
			G.cmds([[\"v\",\"host\"],[\"state\",\"haste\",24],[\"v\",\"host\"],[\"state\",\"slowfall\",5]],unit)
		elif Input.is_action_just_pressed(\"interact\"):
			if unit.weapon:
				if unit.weapon.onswing:
					pilot.set_tasks(unit.weapon.onswing)
			elif G.world.get_item_type_at(\"item\", unit.get_interact_position()):
				pilot.set_task([\"grab\", 6])
			else:
				pilot.set_task([\"interact\", 0])
		elif Input.is_action_just_pressed(\"item\"):
			var pathing = Pathing.new(G.world)
			var pos = G.world.tilemap.world_to_map(unit.get_interact_position())
			G.message(str(pathing.get_routes(pos))+\" : \"+str(pos))
			G.message(\"Dir:\"+str(G.world.tilemap.get_cell_item_orientation(pos.x, pos.y, pos.z))+\" Item:\"+str(G.world.tilemap.get_cell_item(pos.x, pos.y, pos.z)))
			if unit.weapon:
				pilot.set_task([\"drop\", 6])
			else:
				pilot.set_task([\"cmd\", 0, [[\"menu\", \"hand\"]]])

		var camera_basis = camera.global_transform.basis
		var camera_z = camera_basis.z
		var camera_x = camera_basis.x

		camera_z.y = 0
		camera_x.y = 0
		unit.view_z = camera_z.normalized()
		unit.view_x = camera_x.normalized()

		var unit_pos = unit.transform.origin
		var cam_pos = Vector2(unit_pos.x, unit_pos.z)
		camera.transform.origin.x = cam_pos.x
		camera.transform.origin.y = unit_pos.y+2.5# - camera.rotation.x*2 + 2
		camera.transform.origin.z = cam_pos.y
		
		unit.anim_tree[\"parameters/head_v/add_amount\"] = camera.rotation.x * 1.5 + .5


func show_interactable_tip():
	var text = \"\"
	var interactable = G.world.get_item_type_at(\"item\", unit.get_interact_position())
	if interactable:
		text = \"Pick up \"+interactable.item_name.capitalize()
	else:
		interactable = G.world.get_item_type_at(\"object\", unit.get_interact_position())
		if interactable and interactable.item_name:
			text = \"Use \"+interactable.item_name.capitalize()
		else:
			interactable = G.world.get_object_at(unit.get_interact_position())
			if interactable and interactable in G.item.decor_interactions:
				text = \"Interact with \"+interactable.capitalize()
			else:
				interactable = G.world.get_item_type_at(\"furniture\", unit.get_interact_position())
				if interactable:
					text = \"Use \"+interactable.item_name.capitalize()
	interaction_tip.set_text(text)
	if text != \"\":
		interaction_tip.show()
		interaction_tip.rect_position = get_viewport().size / 2 - interaction_tip.rect_size / 2 + Vector2(0, 160)
	else:
		interaction_tip.hide()
"

[sub_resource type="GDScript" id=2]
script/source = "extends CanvasLayer


onready var menu = $Menu
onready var tint = $Menu/Tint
var on = false
var b_pos
var menubutton = preload(\"res://interface/button_resource.tscn\")
var unit


func _ready():
	tint.connect(\"gui_input\", self, \"on_background_click\")
	update_resources()


func on_background_click(event):
	if event is InputEventMouseButton and !event.pressed:
		clear()


func toggle(arg, caller):
	if !on:
		display(arg, caller)
	else:
		clear()
		

func update_resources():
	$Resources/ManaAmount.set_text(str(G.resource[\"mana\"]))
	$Resources/FoodAmount.set_text(str(G.resource[\"food\"]))


func display(arg, caller):
	if on:
		clear()
	get_parent().capture_mouse(0)
	on = true
	tint.show()
	tint.set_size(get_viewport().size)
	menu.show()
	unit = caller
	b_pos = Vector2(200, 120)
	var items = G.item.craftables[arg]
	for item in items:
		add_button(item[0], item[1], item[2])
		if b_pos[1] > 540:
			b_pos = Vector2(700, 120)


func clear():
	get_parent().capture_mouse(1)
	on = false
	tint.hide()
	menu.hide()
	for child in $Menu/Buttons.get_children():
		child.queue_free()


func add_button(name, reqs, args):
	var button = menubutton.instance()
	button.get_node(\"Name\").set_text(name)
	button.set_reqs(reqs[0], reqs[1])
	button.set_position(b_pos)
	button.set_size(Vector2(380, 80))
	button.connect(\"pressed\", self, \"button_pressed\", [args])
	button.set_use_parent_material(true)
	if !G.require_resource(false, reqs[0], reqs[1]):
		button.disabled = true
	$Menu/Buttons.add_child(button)
	b_pos.y += 140


func button_pressed(args):
	G.cmds(args, unit)
	clear()


func display_gather(mana, food):
	var plus = \"\"
	if mana != 0:
		if mana > 0:
			plus = \"+\"
		message(plus+str(mana) + \" Mana\")
	if food != 0:
		if food > 0:
			plus = \"+\"
		message(plus+str(food) + \" Food\")


func message(msg):
	$Messages.add(str(msg))
"

[sub_resource type="GDScript" id=3]
script/source = "extends Control

var pos_v = 0
var timeout = 0


func add(msg):
	set_position(Vector2(64, get_viewport().size.y - 64))
	var label = Label.new()
	label.set_text(msg)
	label.set_scale(Vector2(2, 2))
	for child in get_children():
		var pos = child.get_position()
		child.set_position(Vector2(pos.x, pos.y - 40))
		var color = child.get(\"custom_colors/font_color\")
		if color == null:
			child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
		elif color.a > .2:
			child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.2))
		else:
			child.queue_free()
	label.set_use_parent_material(true)
	add_child(label)
	timeout = 120


func _physics_process(_delta):
	if timeout > 0:
		timeout -= 1
	else:
		for child in get_children():
			var color = child.get(\"custom_colors/font_color\")
			if color == null:
				child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
			elif color.a > .2:
				child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.01))
			else:
				child.queue_free()
"

