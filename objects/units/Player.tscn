[ext_resource path="res://assets/particles/Ambient.tscn" type="PackedScene" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/units/Pilot.gd\"

const GRAVITY = Vector3()
const CAMERA_X_ROT_MIN = deg2rad(-75)
const CAMERA_X_ROT_MAX = deg2rad(40)

# Mouse sensitivity
export(float, 0.1, 1.0) var CAMERA_MOUSE_ROTATION_SPEED = 0.5

onready var springarm = $CameraBase/SpringArm
onready var camera = $CameraBase

var mouse_motion = Vector2()
var mouse_captured = true
var id = 1
var mana = 5
var gold = 0
var pathing = Pathing.new()
var opening_menu = 0
var view_item


func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	springarm.add_excluded_object(self)
	G.factions[1].add(self)
	G.you = self
	G.ui.get_node(\"AnimationPlayer/Fade\").set_size(get_viewport().size)
	G.ui.get_node(\"AnimationPlayer\").play(\"FadeIn\")
	G.ui.update_resources(mana, gold)

func assign(punit):
	.assign(punit)
	unit.item_name = \"inquisitor\"
	unit.hit_glance = true
	G.younit = unit
	set_ability(\"debug\")
	set_faction(1)

func add_resource(pmana, pgold, message=true):
	mana += pmana
	gold += pgold
	if message:
		G.ui.display_gather(pmana, pgold)
	G.ui.update_resources(mana, gold)

func require_resource(spend, pmana, pgold, message=true):
	if mana - pmana >= 0:
		if gold - pgold >= 0:
			if spend:
				add_resource(-mana, -pgold, message)
			return true
		elif spend and message:
			G.message(\"Not enough Gold!\")
	elif spend and message:
		G.message(\"Not enough Mana!\")
	return false


func capture_mouse(mode = -1):
	if mouse_captured or mode == 0:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		mouse_captured = false
	elif !mouse_captured or mode == 1:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		mouse_captured = true


func _input(event):
	if mouse_captured:
		if event is InputEventMouseMotion:
			var rot = event.relative * CAMERA_MOUSE_ROTATION_SPEED
			camera.rotate_y(-rot.x)
			camera.rotation.x += rot.y
			camera.rotation.x = clamp(camera.rotation.x, CAMERA_X_ROT_MIN, CAMERA_X_ROT_MAX)
		view_item = show_interactable_tip()
	if Input.is_action_just_pressed(\"restart\"):
		restart()
	elif Input.is_action_just_pressed(\"ui_fullscreen\"):
		OS.window_fullscreen = !OS.window_fullscreen
	elif Input.is_action_just_pressed(\"ui_mouse\"):
		if G.ui.on:
			G.ui.clear()
		else:
			capture_mouse()


func on_process(delta):
	.on_process(delta)
	var camera_basis = camera.global_transform.basis
	var camera_z = camera_basis.z
	var camera_x = camera_basis.x
	camera_z.y = 0
	camera_x.y = 0
	if len(tasks) == 0:
		unit.view_z = camera_z.normalized()
		unit.view_x = camera_x.normalized()

	var unit_pos = unit.transform.origin
	var cam_pos = Vector2(unit_pos.x, unit_pos.z)
	camera.transform.origin.x = cam_pos.x
	camera.transform.origin.y = unit_pos.y+(1.5*unit.transform.basis.get_scale().y)
	camera.transform.origin.z = cam_pos.y
	unit.anim_tree[\"parameters/head_v/add_amount\"] = camera.rotation.x * 1.5

	if mouse_captured:
		var move_target = Vector2(
				Input.get_action_strength(\"move_right\") - Input.get_action_strength(\"move_left\"),
				Input.get_action_strength(\"move_back\") - Input.get_action_strength(\"move_front\")
			)
		if move_target != Vector2.ZERO:
			opening_menu = 0
			set_task([\"moveto\", .001, move_target.x, move_target.y])

		if Input.is_action_pressed(\"special\"):
			set_task([\"special\", 1])
		elif Input.is_action_just_released(\"special\"):
			if unit.cast < 0:
				G.message(\"Ability on cooldown: \" + str(unit.cast))
		elif Input.is_action_just_pressed(\"interact\"):
			swing(unit.weapon)
		elif Input.is_action_just_pressed(\"item\"):
			if view_item:
				set_task([\"interact\", 0, view_item.transform.origin])
			else:
				var tpathing = Pathing.new()
				tpathing.height = unit.get_position().y+.2
				var pos = G.world.tilemap.world_to_map(unit.get_interact_position())
				G.message(str(tpathing.get_routes_debug(unit.get_interact_position())))
				var dir = G.world.tilemap.get_cell_item_orientation(pos.x, 0, pos.z)
				G.message(\"Pos: \"+str(pos)+\" Item: \"+str(G.world.dungeon_map[pos.y][pos.z]) + \" Dir: \"+str(dir))
		elif Input.is_action_pressed(\"item\"):
			if !G.ui.tooltip.visible:
				set_task([\"wait\", 1, \"work\"])
				opening_menu += 1
				if opening_menu > 32:
					opening_menu = 0
					set_task([\"cmd\", 0, [[\"v\",\"controller\"],[\"menu\",\"shop\"]]])
		else:
			opening_menu = 0

func show_interactable_tip():
	G.ui.set_tooltip(null)
	var item = get_interactable()
	if item:
		if item.item_type == \"item\":
			G.ui.set_tooltip(\"Pick up [\" + item.item_name.capitalize() + \"]\")
		elif item.item_type == \"object\":
			G.ui.set_tooltip(\"Use [\" + item.item_name.capitalize() + \"]\")
		elif item.item_type == \"building\":
			G.ui.set_tooltip(\"Use [\" + item.item_name.capitalize() + \"]\")
		return item


func on_hit(_pos, _hitter, _damage):
	pass


func die():
	set_process(false)
	set_process_input(false)
	G.ui.get_node(\"AnimationPlayer/Fade\").set_size(get_viewport().size)
	G.ui.get_node(\"AnimationPlayer\").play(\"FadeOut\")

func restart():
	print(\"Player:restart: \", get_tree().reload_current_scene())

func hear(_vec):
	pass
"

