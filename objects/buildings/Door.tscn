[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"

const jailDoor = preload(\"res://assets/models/buildings/door_gate.obj\")
const jailDoor_sound = preload(\"res://assets/audio/door_metal.ogg\")
var opened = 0
var triggerReady = true

func _ready():
	if $Tween.connect(\"tween_all_completed\", self, \"trigger_done\") != 0:
		print(\"Door Tween connection error\")

func to_fence():
	$CollisionShape/Door.mesh = jailDoor
	$Creak.stream = jailDoor_sound
	dat.a(\"defense\", dat.g(\"jail_defense\",0))

func trigger(user):
	if triggerReady:
		triggerReady = false
		var tween = $Tween
		var target_degrees
		var unitpos = user.transform.origin
		var objpos = transform.origin
		if opened == 0:
			if unitpos.direction_to(objpos).dot(transform.basis.z) > 0:
				opened = -80
			else:
				opened = 80
			target_degrees = rotation_degrees + Vector3(0, opened, 0)
		else:
			if user.item_name != \"player\":
				return
			target_degrees = rotation_degrees + Vector3(0, -opened, 0)
			opened = 0
		tween.interpolate_property(self, \"rotation_degrees\",
				rotation_degrees, target_degrees, 2,
				Tween.TRANS_QUAD, Tween.EASE_OUT)
		tween.start()
		$Creak.play()

func trigger_done():
	triggerReady = true
"

