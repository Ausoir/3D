[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Item.gd\"


func on_make():
	var r = open_walls()
	for child in r:
		child.open_walls()


func open_walls():
	var r = []
	for child in G.world.objects.get_children():
		if child.get_script() == get_script():
			if child.transform.origin == get_adjacent(0, 6):
				if get_node(\"Door\") and is_instance_valid($Door):
					r.append(child)
			if child.transform.origin == get_adjacent(0, -6):
				if get_node(\"WallB\") and is_instance_valid($WallB):
					$WallB.queue_free()
					$StaticBody/Back.queue_free()
					r.append(child)
			if child.transform.origin == get_adjacent(-6, 0):
				if get_node(\"WallR\") and is_instance_valid($WallR):
					$WallR.queue_free()
					$StaticBody/Right.queue_free()
					r.append(child)
			if child.transform.origin == get_adjacent(6, 0):
				if get_node(\"WallL\") and is_instance_valid($WallL):
					$WallL.queue_free()
					$StaticBody/Left.queue_free()
					r.append(child)
	return r


func get_adjacent(x, y):
	var h = Vector2(x, y).rotated(-transform.basis.get_euler().y)
	var pos = transform.origin
	var target_pos = Vector3(pos.x + h.x, pos.y, pos.z + h.y)
	return target_pos
"

