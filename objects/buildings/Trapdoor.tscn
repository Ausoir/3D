[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"

var opened = false

func trigger(user):
	if !opened:
		if user.status.has_state(\"key\"):
			opened = true
			$TriggerAnimation.play(\"Open\")
			dat.a(\"onuse\", [[\"t\",global_transform.origin],[\"particle\",\"blood\",9]])
			$Open.play()
			$Ambient.play()
		else:
			$TriggerAnimation.play(\"Locked\")
			$Locked.play()
"

