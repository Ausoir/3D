script/source = "extends \"res://objects/Building.gd\"


func open_walls():
	if G.world.rng.randi_range(0, 1) == 0:
		if rid(\"Crate3\"):
			if G.world.rng.randi_range(0, 1) == 0:
				rid(\"Crate1\")
	if G.world.rng.randi_range(0, 2) == 0:
		rid(\"Crate4\")
	if G.world.rng.randi_range(0, 1) == 0:
		if rid(\"Crate5\"):
			if G.world.rng.randi_range(0, 1) == 0:
				rid(\"Crate2\")
"

