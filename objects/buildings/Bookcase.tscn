[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Lootable.gd\"

const models = [
	preload(\"res://assets/models/buildings/bookcase.obj\"),
	preload(\"res://assets/models/buildings/bookcase_broken.obj\"),
	preload(\"res://assets/models/buildings/bookcaseWide.obj\"),
	preload(\"res://assets/models/buildings/bookcaseWide_broken.obj\"),
]
const models_filled = [
	preload(\"res://assets/models/buildings/bookcaseFilled.obj\"),
	preload(\"res://assets/models/buildings/bookcaseFilled_broken.obj\"),
	preload(\"res://assets/models/buildings/bookcaseWideFilled.obj\"),
	preload(\"res://assets/models/buildings/bookcaseWideFilled_broken.obj\"),
]
var model_index = 0

func open_walls():
	if G.world.rng.randi_range(0, 5) == 0:
		model_index = G.world.rng.randi_range(4, 7)
		$Bookcase/MeshInstance.mesh = models_filled[model_index - 4]
	else:
		model_index = G.world.rng.randi_range(0, 3)
		$Bookcase/MeshInstance.mesh = models[model_index]
		dat.a(\"onuse\", null)

func trigger(arg):
	if model_index >= 4:
		.trigger(arg)
		$Bookcase/MeshInstance.mesh = models[model_index - 4]
"

