[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Lootable.gd\"

func open_walls():
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"CollisionShape/Object1\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"CollisionShape/Object2\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"CollisionShape/Object3\")

func trigger(arg):
	if is_instance_valid($CollisionShape/Object1) or is_instance_valid($CollisionShape/Object2) or is_instance_valid($CollisionShape/Object3):
		.trigger(arg)
		rid(\"CollisionShape/Object1\")
		rid(\"CollisionShape/Object2\")
		rid(\"CollisionShape/Object3\")
"

