[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Lootable.gd\"

const models = [
	preload(\"res://assets/models/buildings/chest_uncommon.obj\"),
	preload(\"res://assets/models/buildings/chestTop_uncommon.obj\"),
	preload(\"res://assets/models/buildings/chest_rare.obj\"),
	preload(\"res://assets/models/buildings/chestTop_rare.obj\"),
	preload(\"res://assets/models/buildings/chest_common.obj\"),
]

func open_walls():
	var rare = dat.g(\"rarity\", 0) - G.rng.randi_range(0, 1)
	if rare == 1:
		$Chest/Chest.mesh = models[4]
	elif rare == 2:
		$Chest/Chest.mesh = models[0]
		$Chest/Lid.mesh = models[1]
	elif rare == 3:
		$Chest/Chest.mesh = models[2]
		$Chest/Lid.mesh = models[3]

"

