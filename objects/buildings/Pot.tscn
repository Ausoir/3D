script/source = "extends \"res://objects/Building.gd\"
const models = [
	preload(\"res://assets/models/buildings/potA.obj\"),
	preload(\"res://assets/models/buildings/potB.obj\"),
	preload(\"res://assets/models/buildings/potC.obj\"),
	preload(\"res://assets/models/buildings/potA_decorated.obj\"),
	preload(\"res://assets/models/buildings/potB_decorated.obj\"),
	preload(\"res://assets/models/buildings/potC_decorated.obj\"),
]

var unit_size = Vector3(.5,.5,.5)

func open_walls():
	resize(G.rng.randf()*.2)
	$MeshInstance.mesh = G.world.rng.rand_arr(models)
"

