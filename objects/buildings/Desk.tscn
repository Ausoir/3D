[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"


func open_walls():
	if G.world.rng.randi_range(0, 2) > 0:
		rid(\"Table/Book\")
		if G.world.rng.randi_range(0, 2) > 0:
			rid(\"Table/Lectern\")
	if is_instance_valid($Table/Lectern):
		rid(\"Table/Object1\")
		rid(\"Table/Object2\")
		rid(\"Table/Object3\")
		rid(\"Table/Object4\")
		rid(\"Table/Object5\")
		rid(\"Table/Object7\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Table/Object6\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Table/Object8\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Table/Object9\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Table/Object10\")
"

