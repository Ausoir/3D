[ext_resource path="res://assets/textures/spell.png" type="Texture" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Area

var faction = 0
var speed = 1
var current_state = 0
var mat
var lifetime = 0
onready var effect = $Particles

func _ready():
	var _err = $Tween.connect(\"tween_all_completed\", self, \"_tween_done\")
	G.make_particle(\"dust\", transform.origin, 2)
	mat = effect.draw_pass_1.surface_get_material(0).duplicate()
	effect.draw_pass_1.surface_set_material(0, mat)
	$Tween.interpolate_method(self, \"_tween_update\",
			0, 1, 2,
			Tween.TRANS_QUAD, Tween.EASE_OUT)
	$Tween.start()

func trigger(_body):
	current_state = 2
	$Tween.interpolate_method(self, \"_tween_update\",
			1, -1, .5,
			Tween.TRANS_LINEAR)
	$Tween.start()

func _tween_update(val):
	mat.set_shader_param(\"dissolve\", val)

func _body_entered(body):
	if current_state == 1 and body is KinematicBody:
		trigger(body)

func _tween_done():
	if current_state == 0:
		current_state = 1
		lifetime = 5
	else:
		explode()

func _process(delta):
	if lifetime > 0:
		lifetime -= delta
		if lifetime <= 0:
			trigger(null)

func explode():
	var objs = get_overlapping_bodies()
	for obj in objs:
		if obj is KinematicBody:
			obj.on_hit(transform.origin, null, 6, [\"magic\"])
	G.make_particle(\"overcharge\", transform.origin, 1)
	G.make_particle(\"dust\", transform.origin, 2)
	queue_free()
"

