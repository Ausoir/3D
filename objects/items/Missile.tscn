[sub_resource type="PhysicsMaterial" id=1]
bounce = 0.5

[sub_resource type="GDScript" id=2]
script/source = "extends RigidBody

var faction = 0
var target
var speed = 1
var lifetime = 1
var onhit

func shoot(towards):
#	pass
#	var to = Vector3(G.rng.randi_range(-12, 12),
#					   G.rng.randi_range(-12, 4),
#					   G.rng.randi_range(-12, 12))
	apply_central_impulse(towards * 12)
	target = G.find_target_los(transform.origin, 100, faction, self)

func trigger(obj):
	if obj is KinematicBody and obj.get(\"item_type\") and obj.item_type == \"unit\":
		if obj.controller.faction != faction:
			G.make_particle(\"hit\", transform.origin, 1)
			G.cmds(onhit, obj)
			queue_free()

func _physics_process(delta):
	if target and is_instance_valid(target) and !target.dat.is_dead():
		speed += delta * 16
		add_central_force((target.get_view_position() - transform.origin) * speed)
		var colls = get_colliding_bodies()
		for coll in colls:
			trigger(coll)
	if G.time.half_second:
		target = G.find_target_los(transform.origin, 100, faction, self)
	lifetime -= delta * .2
	scale = Vector3(lifetime, lifetime, lifetime)
	if lifetime < .1:
		queue_free()
"

