[sub_resource type="QuadMesh" id=3]
material = SubResource( 2 )

[sub_resource type="GDScript" id=4]
script/source = "extends MeshInstance

var target
var shooter
var shock1
var shock2

func shoot(pshooter, pos, ptarget):
	shooter = pshooter
	target = ptarget
	if target:
		var target_pos = target.get_interact_position()
		shock1 = G.make_particle(\"shock\", transform.origin, 9999)
		shock2 = G.make_particle(\"shock\", target_pos, 9999)
		target.on_hit(target_pos, null, 1, [\"magic\"])
	else:
		queue_free()

func die():
	if shock1:
		shock1.duration = 0
	if shock2:
		shock2.duration = 0
	queue_free()

func _physics_process(_delta):
	on_process()
	
func on_process():
	if target and is_instance_valid(target):
		if target.dat.is_dead():
			die()
		elif shooter.state != \"special\":
			die()
		else:
			var target_pos = target.get_interact_position()
			var shooting_pos = shooter.get_hand_position()
			var diff = target_pos - shooting_pos
			var dist = diff.length()
			look_at_from_position(shooting_pos + diff/2, target_pos, Vector3.FORWARD)
			rotate_y(1.57)
			scale.y = dist
			shock1.translation = shooting_pos
			shock2.translation = target_pos
			if G.time.quarter_second:
				G.message(rotation)
				target.on_hit(target_pos, null, 1, [\"magic\"])
	else:
		die()
"

