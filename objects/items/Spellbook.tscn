[gd_scene load_steps=2 format=2]

[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Item.gd\"

const models = [
	preload(\"res://assets/models/bookA.obj\"),
	preload(\"res://assets/models/bookB.obj\"),
	preload(\"res://assets/models/bookC.obj\"),
	preload(\"res://assets/models/bookD.obj\"),
	preload(\"res://assets/models/bookE.obj\"),
	preload(\"res://assets/models/bookF.obj\"),
]

var spell

func _ready():
	._ready()
	self.mesh = G.world.rng.rand_arr(models)
	var spell_type = G.rng.rand_arr(G.factory.spells)
	spell = G.rng.rand_arr(spell_type)

func trigger(arg):
	G.cmds([[\"v\",\"controller\",\"$h\"],[\"spell\",\"learn\",spell,true]], arg)
	die()
"

