[sub_resource type="GDScript" id=2]
script/source = "extends RigidBody

var faction = 0
var speed = 1
var lifetime = 1
var onhit

func shoot(towards):
#	pass
#	var to = Vector3(G.rng.randi_range(-12, 12),
#					   G.rng.randi_range(-12, 4),
#					   G.rng.randi_range(-12, 12))
	apply_central_impulse(towards * 16)

func _physics_process(delta):
	lifetime -= delta * .5
	if lifetime < .1:
		queue_free()

func _on_body_entered(body):
	if body.get(\"item_type\"):
		G.make_particle(\"hit\", transform.origin, 1)
		G.cmds(onhit, body)
		queue_free()
"

