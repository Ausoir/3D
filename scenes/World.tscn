[sub_resource type="GDScript" id=12]
script/source = "extends WorldEnvironment


onready var light = $DirectionalLight
var sky
var frame = 0
var light_time = [
	Color(.1, 0, .2, .5),
	Color(1, .3, 0),
	Color(1, 1, 1),
]
var target_color = Color(.5, .8, .9, .5)


func _ready():
	sky = get_environment()

func _physics_process(delta):
	light.rotate_x(delta * .15)
	var sun_rot = light.rotation.normalized()
	var sunlight = abs(sun_rot.x)
	var sunrise = sun_rot.z < 0
	sky.background_energy = max(.01, -sun_rot.x)
	if sunlight < delta:
		light.set_visible(sunrise)
		if sunrise:
			set_target_color(1)
		else:
			light.set_color(light_time[0])
	elif sunlight > .3 and sunlight < .3 + delta:
		if sunrise:
			set_target_color(2)
		else:
			set_target_color(1)
	light.set_param(Light.PARAM_ENERGY, sunlight * 2)
	if frame < 1.1:
		light.light_color = light.light_color.linear_interpolate(target_color, frame)
		frame += delta * .1


func set_target_color(target):
	target_color = light_time[target]
	frame = 0
"

