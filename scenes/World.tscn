[sub_resource type="GDScript" id=6]
script/source = "extends MeshInstance


var frame = 0
var movement = Vector3()
var player
var material


func _ready():
	player = get_parent().get_node(\"Player/Unit\")
	material = get_surface_material(0)


func _physics_process(delta):
	var fluctuation = sin(frame) * .01
	movement.x = fluctuation
	movement.z = fluctuation
	material.normal_scale += fluctuation
	material.depth_scale += fluctuation
	if (player.transform.origin - transform.origin).length() > 60:
		transform.origin.x = player.transform.origin.x
		transform.origin.z = player.transform.origin.z
	transform.origin.y = 4.8 + fluctuation
	global_translate(movement)
	frame += delta * .1
"

[sub_resource type="GDScript" id=7]
script/source = "extends Spatial

var models = {
	\"object\": preload(\"res://object/Object.tscn\"),
	#campfire, bed, special items, etc
}
var materials = {
	\"grass\": preload(\"res://assets/mat_grass.tres\"),
	\"foliage\": preload(\"res://assets/mat_bush.tres\"),
	\"dirt\": preload(\"res://assets/mat_dirt.tres\"),
}
var rng


func _ready():
	for v in models.values():
		var model_instance = v.instance()
		var count = 0
		for model_list in model_instance.models:
			for model in model_list:
				model_instance.set_mesh(model)
				model_instance.set_mat(count, materials)
			count += 1


func make(model, type, pos):
	var r = models[model].instance()
	var model_list = r.models[type]
	r.set_mesh(model_list[rng.randi_range(0, model_list.size()-1)])
	r.transform.origin = pos + Vector3(rng.randf_range(-2, 2), 0, rng.randf_range(-2, 2))
	r.transform.rotated(Vector3.UP, rng.randi_range(0, 359))
	r.transform.scaled(Vector3(rng.randf_range(.8, 1.2), rng.randf_range(.8, 1.2), rng.randf_range(.8, 1.2)))
	add_child(r)
	return r
"

