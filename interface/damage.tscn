[ext_resource path="res://assets/Baumans-Regular.ttf" type="DynamicFontData" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

onready var node_quad = $Quad
var lifetime = 1

func _process(delta):
	lifetime -= delta
	if lifetime < 0:
		queue_free()

func display(damage, clr=null):
	$Viewport/Label.set_text(str(damage))
	if clr:
		$Viewport/Label.add_color_override(\"font_color\", clr)
	node_quad.emitting = true
"

