[sub_resource type="GDScript" id=1]
script/source = "extends CanvasLayer

const Menubutton = preload(\"res://interface/button_resource.tscn\")
const Itembutton = preload(\"res://interface/button_item.tscn\")
const Healthbar = preload(\"res://interface/health.tscn\")
onready var menu = $Menu
onready var tint = $Menu/Tint
onready var tooltip = $Interaction
onready var tabs = $Menu/Tabs
onready var tab_character = $Menu/Tabs/Character/Buttons
onready var tab_equipment = $Menu/Tabs/Equipment/Buttons
onready var tab_shop = $Menu/Tabs/Shop/Buttons
var on = false
var host
var argument


func _ready():
	tint.connect(\"gui_input\", self, \"on_background_click\")


func _process(_delta):
	$FPS.set_text(str(Engine.get_frames_per_second())+' FPS')


func on_background_click(event):
	if event is InputEventMouseButton and !event.pressed:
		clear()


func display(arg, playerID):
	if on:
		clear()
	on = true
	host = G.get_player(playerID)
	argument = arg
	G.you.capture_mouse(0)
	tint.set_size(get_viewport().size)
	menu.show()
	tabs.rect_position = get_viewport().size / 2 - tabs.rect_size / 2
	on_tab_select(tabs.current_tab)


func clear():
	G.you.capture_mouse(1)
	on = false
	menu.hide()


func button_pressed(args):
	G.cmds(args, host.unit)
	clear()


func display_gather(gold):
	var plus = \"\"
	if gold != 0:
		if gold > 0:
			plus = \"+\"
		message(plus+str(gold) + \" Gold\")


func set_tooltip(msg):
	if msg == null:
		tooltip.hide()
	else:
		tooltip.set_text(msg)
		tooltip.show()
		tooltip.rect_position = get_viewport().size / 2 - tooltip.rect_size / 2 + Vector2(0, 160)


func message(msg):
	$Messages.add(str(msg))


func on_tab_select(tab):
	for child in tab_character.get_children():
		child.queue_free()
	for child in tab_equipment.get_children():
		child.queue_free()
	for child in tab_shop.get_children():
		child.queue_free()
	if tab == 0:
		fill_character()
	elif tab == 1:
		fill_equipment()
	elif tab == 3:
		fill_shop()

func fill_equipment():
	var equipments = []
	var hostUnit = host.unit
	if hostUnit.weapon:
		equipments.append([\"HELD\", hostUnit.weapon])
	for i in hostUnit.armors:
		equipments.append([i, hostUnit.armors[i]])
	for equipment in equipments:
		var item = equipment[1]
		var button = Itembutton.instance()
		if item == hostUnit.weapon:
			button.connect(\"pressed\", self, \"button_pressed\", [[[\"t\",null],[\"wield\"]]])
		else:
			button.connect(\"pressed\", self, \"button_pressed\", [[[\"unequip\",equipment[0]]]])
		button.get_node(\"Container/Category\").set_text(equipment[0].to_upper())
		button.get_node(\"Container/Name\").set_text(item.item_name.capitalize())
		for property in item.properties:
			if property in [\"weight\", \"defense\", \"health\", \"damage\", \"speed\"]:
				var label = Label.new()
				label.set_text(property.capitalize() + \"   \" + str(item.properties[property]))
				button.get_node(\"Container\").add_child(label)
			elif property == \"tags\":
				for tag in item.properties.tags:
					var desc = G.factory.get_description(tag)
					if !desc.empty():
						var label = Label.new()
						label.set_text(desc)
						button.get_node(\"Container\").add_child(label)
		tab_equipment.add_child(button)
		button.get_node(\"Container/Category\").rect_min_size.x = tab_equipment.rect_size.x - 14
		button.rect_min_size.y = button.get_node(\"Container\").rect_size.y + 14

func fill_character():
	tab_character.add_child(Healthbar.instance())
	var stats = G.younit.update_stats()
	stats['gold'] = G.you.gold
	var label = Label.new()
	label.add_font_override(\"font\", G.font)
	tab_character.add_child(label)
	for stat in stats:
		label = Label.new()
		label.add_font_override(\"font\", G.font)
		label.set_text(stat.capitalize() + \": \" + str(stats[stat]))
		tab_character.add_child(label)

func fill_shop():
	var items = G.factory.craftables[argument]
	for item in items:
		var reqs = item[1]
		var button = Menubutton.instance()
		button.get_node(\"Name\").set_text(item[0])
		button.set_reqs(reqs[0])
		button.set_size(Vector2(380, 80))
		button.connect(\"pressed\", self, \"button_pressed\", [item[2]])
		button.set_use_parent_material(true)
		if !G.you.require_resource(false, reqs[0]):
			button.disabled = true
		if !button.disabled:
			var desc = button.get_node(\"Reqs\")
			desc.add_color_override(\"font_color\", Color(1,1,1))
			desc.set_text(G.factory.get_description(name))
		tab_shop.add_child(button)
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

var pos_v = 0
var timeout = 0


func add(msg):
	set_position(Vector2(64, get_viewport().size.y - 64))
	var label = Label.new()
	label.add_font_override(\"font\", G.font)
	label.set_text(msg)
	for child in get_children():
		var pos = child.get_position()
		child.set_position(Vector2(pos.x, pos.y - 40))
		var color = child.get(\"custom_colors/font_color\")
		if color == null:
			child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
		elif color.a > .2:
			child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.2))
		else:
			child.queue_free()
	label.set_use_parent_material(true)
	add_child(label)
	timeout = 120


func _physics_process(_delta):
	if timeout > 0:
		timeout -= 1
	else:
		for child in get_children():
			var color = child.get(\"custom_colors/font_color\")
			if color == null:
				child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
			elif color.a > .2:
				child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.01))
			else:
				child.queue_free()
"

[sub_resource type="Shader" id=3]
code = "shader_type canvas_item;

uniform sampler2D flowMap; //Displacement map
uniform float strength;    //Force of the effect
uniform float speed;       //Speed of the effect
uniform int frames : hint_range(1, 10); //Frames of the effect

//Returns a value between 0 and 1 depending of the frames -> exemple: frames = 4, frame 1 = 0.25
float clock(float time){
	float fframes = float(frames);
	return floor(mod(time * speed, fframes)) / fframes;
}

void fragment(){
	float c = clock(TIME); //Get clock frame
	vec4 offset = texture(flowMap, vec2(UV.x + c, UV.y + c)) * strength; //Get offset 
	//COLOR = texture(TEXTURE, vec2(UV.x,UV.y) + normal.xy); //Apply offset
	COLOR = texture(TEXTURE, vec2(UV.x,UV.y) + offset.xy - vec2(0.5,0.5)*strength); //We need to remove the displacement 
}


// TEST CLOCK
/*
void fragment(){
	float c = clock(TIME);
	COLOR = vec4( c, c, c, 1);
}
*/"

