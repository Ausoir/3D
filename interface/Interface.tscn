[sub_resource type="GDScript" id=1]
script/source = "extends CanvasLayer

const Menubutton = preload(\"res://interface/button_resource.tscn\")
const Itembutton = preload(\"res://interface/button_item.tscn\")
onready var menu = $Menu
onready var tint = $Menu/Tint
onready var tooltip = $Interaction
onready var tab_equipment = $Menu/Tabs/Equipment/Buttons
onready var tab_construct = $Menu/Tabs/Construct/Buttons
var on = false
var host
var argument


func _ready():
	tint.connect(\"gui_input\", self, \"on_background_click\")
	update_resources()


func _process(_delta):
	$FPS.set_text(str(Engine.get_frames_per_second())+' FPS')


func on_background_click(event):
	if event is InputEventMouseButton and !event.pressed:
		clear()


func update_resources():
	var team = G.factions[G.you.pilot.faction]
	$Menu/Resources/ManaAmount.set_text(str(team.resource[\"mana\"]))
	$Menu/Resources/FoodAmount.set_text(str(team.resource[\"food\"]))


func display(arg, phost):
	if on:
		clear()
	on = true
	host = phost
	argument = arg
	G.you.capture_mouse(0)
	tint.show()
	tint.set_size(get_viewport().size)
	menu.show()
	$Menu/Tabs.rect_position = get_viewport().size / 2 - $Menu/Tabs.rect_size / 2
	$Menu/Health.rect_position.x = get_viewport().size.x / 2 - $Menu/Health.progress_bar.rect_size.x / 2
	$Menu/Health.display(G.younit.health.x, G.younit.health.y, G.younit.item_name, G.younit.level)
	on_tab_select($Menu/Tabs.current_tab)


func clear():
	G.you.capture_mouse(1)
	on = false
	tint.hide()
	menu.hide()


func add_button(name, reqs, args):
	var button = Menubutton.instance()
	button.get_node(\"Name\").set_text(name)
	button.set_reqs(reqs[0], reqs[1])
	button.set_size(Vector2(380, 80))
	button.connect(\"pressed\", self, \"button_pressed\", [args])
	button.set_use_parent_material(true)
	var team = G.factions[G.you.pilot.faction]
	if !team.require_resource(false, reqs[0], reqs[1]):
		button.disabled = true
	var desc = button.get_node(\"Reqs\")
	if len(reqs) > 2:
		var reqsUnmet = \"\"
		for reqbuilding in reqs[2]:
			if !team.has_building(reqbuilding):
				reqsUnmet = \"Requires \" + reqbuilding.capitalize() + \"\\n\"
				button.disabled = true
		desc.add_color_override(\"font_color\", Color(1,0,0))
		desc.set_text(reqsUnmet)
	if !button.disabled:
		desc.add_color_override(\"font_color\", Color(1,1,1))
		desc.set_text(G.factory.get_description(name))
	tab_construct.add_child(button)


func button_pressed(args):
	G.cmds(args, host)
	clear()


func display_gather(mana, food):
	var plus = \"\"
	if mana != 0:
		if mana > 0:
			plus = \"+\"
		message(plus+str(mana) + \" Mana\")
	if food != 0:
		if food > 0:
			plus = \"+\"
		message(plus+str(food) + \" Food\")


func set_tooltip(msg):
	if msg == null:
		tooltip.hide()
	else:
		tooltip.set_text(msg)
		tooltip.show()
		tooltip.rect_position = get_viewport().size / 2 - tooltip.rect_size / 2 + Vector2(0, 160)


func message(msg):
	$Messages.add(str(msg))


func on_tab_select(tab):
	for child in $Menu/Tabs/Equipment/Buttons.get_children():
		child.queue_free()
	for child in $Menu/Tabs/Construct/Buttons.get_children():
		child.queue_free()
	if tab == 0:
		var items = G.factory.craftables[argument]
		for item in items:
			add_button(item[0], item[1], item[2])
	elif tab == 1:
		if host.weapon:
			fill_equipment(\"HELD\", host.weapon)
		for i in host.armors:
			fill_equipment(i.to_upper(), host.armors[i])


func fill_equipment(category, item):
	var button = Itembutton.instance()
	button.connect(\"pressed\", self, \"button_pressed\", [[[\"v\",\"parent\"],[\"order\",[[\"drop\", 6]]]]])
	button.get_node(\"Container/Category\").set_text(category)
	button.get_node(\"Container/Name\").set_text(item.item_name.capitalize())
	for property in item.properties:
		if property in [\"defense\", \"health\", \"damage\", \"speed\"]:
			var label = Label.new()
			label.set_text(property.capitalize() + \"   \" + str(item.properties[property]))
			button.get_node(\"Container\").add_child(label)
		elif property == \"tags\":
			for tag in item.properties.tags:
				var desc = G.factory.get_description(tag)
				if !desc.empty():
					var label = Label.new()
					label.set_text(desc)
					button.get_node(\"Container\").add_child(label)
	tab_equipment.add_child(button)
	button.get_node(\"Container/Category\").rect_min_size.x = tab_equipment.rect_size.x - 14
	button.rect_min_size.y = button.get_node(\"Container\").rect_size.y + 14
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

const font = preload(\"res://assets/font_message.tres\")
var pos_v = 0
var timeout = 0


func add(msg):
	set_position(Vector2(64, get_viewport().size.y - 64))
	var label = Label.new()
	label.add_font_override(\"font\", font)
	label.set_text(msg)
	for child in get_children():
		var pos = child.get_position()
		child.set_position(Vector2(pos.x, pos.y - 40))
		var color = child.get(\"custom_colors/font_color\")
		if color == null:
			child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
		elif color.a > .2:
			child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.2))
		else:
			child.queue_free()
	label.set_use_parent_material(true)
	add_child(label)
	timeout = 120


func _physics_process(_delta):
	if timeout > 0:
		timeout -= 1
	else:
		for child in get_children():
			var color = child.get(\"custom_colors/font_color\")
			if color == null:
				child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
			elif color.a > .2:
				child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.01))
			else:
				child.queue_free()
"

