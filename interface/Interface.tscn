[sub_resource type="GDScript" id=1]
script/source = "extends CanvasLayer

const Itembutton = preload(\"res://interface/button_item.tscn\")
onready var menu = $Menu
onready var tint = $Menu/Tint
onready var tooltip = $Interaction
onready var hidden = $Menu/Hidden
onready var tabs = $Menu/Tabs
onready var tab_character = $Menu/Tabs/Character/Buttons
onready var tab_equipment = $Menu/Tabs/Equipment/Buttons
var on = false
var host
var argument


func _ready():
	tint.connect(\"gui_input\", self, \"on_background_click\")

func bring_tab(tab_name):
	if !tabs.has_node(tab_name):
		var shop = hidden.get_node(tab_name)
		hidden.remove_child(shop)
		tabs.add_child(shop)
		tabs.set_current_tab(tabs.get_child_count()-1)
		shop.on_bring(self)
	else:
		tabs.get_node(tab_name).on_bring(self)

func stash_tab(tab_name):
	if tabs.has_node(tab_name):
		var shop = tabs.get_node(tab_name)
		tabs.remove_child(shop)
		hidden.add_child(shop)
		tabs.set_current_tab(min(tabs.current_tab, tabs.get_child_count()-1))

func _process(_delta):
	$FPS.set_text(str(Engine.get_frames_per_second())+' FPS')

func on_background_click(event):
	if event is InputEventMouseButton and !event.pressed:
		clear()

func display(arg, player):
	if on:
		clear()
	on = true
	host = player
	G.you.capture_mouse(0)
	tint.set_size(get_viewport().size)
	menu.show()
	var screen_center = get_viewport().size / 2
	tabs.rect_position = screen_center - tabs.rect_size / 2
	on_tab_select(tabs.current_tab)
	argument = arg
	if !argument.empty():
		bring_tab(argument)
	else: #stash all tabs
		stash_tab(\"Shop\")

func clear():
	on = false
	G.you.capture_mouse(1)
	menu.hide()

func _button_pressed(args):
	G.cmds(args, host.unit)
	clear()

func display_gather(mana, gold):
	var plus = \"\"
	if mana != 0:
		if mana > 0:
			plus = \"+\"
		message(plus+str(mana) + \" Mana\")
	if gold != 0:
		if gold > 0:
			plus = \"+\"
		message(plus+str(mana) + \" Gold\")

func update_resources(mana, gold):
	$Menu/Info/ManaAmount.text = str(mana)
	$Menu/Info/GoldAmount.text = str(gold)

func set_tooltip(msg):
	if msg == null:
		tooltip.hide()
	else:
		tooltip.set_text(msg)
		tooltip.show()
		tooltip.rect_position = get_viewport().size / 2 - tooltip.rect_size / 2 + Vector2(0, 160)

func message(msg):
	$Messages.add(str(msg))

func on_tab_select(tab):
	for child in tab_character.get_children():
		child.queue_free()
	for child in tab_equipment.get_children():
		child.queue_free()
	if tab == 0:
		fill_character()
	elif tab == 1:
		fill_equipment()

func fill_equipment():
	var equipments = []
	var hostUnit = host.unit
	if hostUnit.weapon:
		equipments.append([\"HELD\", hostUnit.weapon])
	for i in hostUnit.armors:
		equipments.append([i, hostUnit.armors[i]])
	for equipment in equipments:
		var item = equipment[1]
		var button = Itembutton.instance()
		if item == hostUnit.weapon:
			button.connect(\"pressed\", self, \"_button_pressed\", [[[\"t\",null],[\"wield\"]]])
		else:
			button.connect(\"pressed\", self, \"_button_pressed\", [[[\"unequip\",equipment[0]]]])
		button.get_node(\"Container/Category\").set_text(equipment[0].to_upper())
		button.get_node(\"Container/Name\").set_text(item.item_name.capitalize())
		for property in [\"weight\", \"defense\", \"health\", \"damage\", \"speed\"]:
			var theproperty = item.dat.g(property)
			if theproperty:
				var label = Label.new()
				label.set_text(property.capitalize() + \"   \" + str(theproperty))
				button.get_node(\"Container\").add_child(label)
		var tags = item.dat.g(\"tags\", [])
		for tag in tags:
			var desc = G.factory.get_description(tag)
			if !desc.empty():
				var label = Label.new()
				label.set_text(desc)
				button.get_node(\"Container\").add_child(label)
		tab_equipment.add_child(button)
		button.get_node(\"Container/Category\").rect_min_size.x = tab_equipment.rect_size.x - 14
		button.rect_min_size.y = button.get_node(\"Container\").rect_size.y + 14

func fill_character():
	var hostUnit = host.unit
	var stats = hostUnit.update_stats()
	for stat in stats:
		var label = Label.new()
		label.set_text(stat.capitalize() + \": \" + str(stats[stat]))
		label.mouse_filter = Control.MOUSE_FILTER_STOP
		label.hint_tooltip = G.factory.get_description(stat)
		tab_character.add_child(label)
	for property in hostUnit.dat.v:
		if property.substr(0, 2) == \"s_\":
			var property_name = property.substr(2)
			var label = Label.new()
			var experience = hostUnit.dat.v[property]
			var levels = G.dec2base2(experience)
			label.set_text(\"Mastery - \" + property_name.capitalize() + \": \" + str(levels))
			label.mouse_filter = Control.MOUSE_FILTER_STOP
			label.hint_tooltip = G.factory.get_description(property_name)
			tab_character.add_child(label)
"

[sub_resource type="GDScript" id=2]
script/source = "extends Control

var pos_v = 0
var timeout = 0


func add(msg):
	set_position(Vector2(64, get_viewport().size.y - 64))
	var label = Label.new()
	label.set_text(msg)
	for child in get_children():
		var pos = child.get_position()
		child.set_position(Vector2(pos.x, pos.y - 40))
		var color = child.get(\"custom_colors/font_color\")
		if color == null:
			child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
		elif color.a > .2:
			child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.2))
		else:
			child.queue_free()
	label.set_use_parent_material(true)
	add_child(label)
	timeout = 120


func _physics_process(_delta):
	if timeout > 0:
		timeout -= 1
	else:
		for child in get_children():
			var color = child.get(\"custom_colors/font_color\")
			if color == null:
				child.set(\"custom_colors/font_color\", Color(1, 1, 1, 1))
			elif color.a > .2:
				child.set(\"custom_colors/font_color\", Color(color.r, color.g, color.b, color.a-.01))
			else:
				child.queue_free()
"

