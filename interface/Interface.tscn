[sub_resource type="GDScript" id=7]
script/source = "extends Control

const Menubutton = preload(\"res://interface/button_resource.tscn\")

func on_bring(interface):
	for tab in get_children():
		var vbox = tab.get_child(0)
		for item in vbox.get_children():
			item.queue_free()
	var menu = interface.host.known_spells
	var count = 0
	for items in menu:
		var category = get_child(count).get_node(\"Buttons\")
		for item in items:
			var button = Menubutton.instance()
			var reqs = item[1]
			button.get_node(\"Name\").set_text(item[0])
			button.set_reqs(reqs)
			button.set_size(Vector2(380, 80))
			button.connect(\"pressed\", interface, \"_button_pressed\", [item[2]])
			button.set_use_parent_material(true)
			button.hint_tooltip = G.factory.get_description(item[0])
			if !G.you.require_resource(false, reqs[0], reqs[1]):
				button.disabled = true
			category.add_child(button)
		count += 1

func _on_tab_select(_tab):
	pass # Replace with function body.
"

[sub_resource type="GDScript" id=8]
script/source = "extends Control


func on_bring(_argument):
	pass

func _gui_input(event):
	if Input.is_action_pressed(\"interact\"):
		if event is InputEventMouseMotion:
			var pos = $Viewport/SkillTree.rect_position + event.relative
			$Viewport/SkillTree.rect_position = pos
"

