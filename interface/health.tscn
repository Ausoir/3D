[sub_resource type="GDScript" id=1]
script/source = "extends Control

onready var progress_bar = $ProgressBar
onready var label = $ProgressBar/Label
onready var levellabel = $ProgressBar/Panel/LevelLabel


func display(hp, mhp, display_name, level):
	label.set_text(display_name.capitalize())
	if level > 0:
		levellabel.set_text(str(level))
	progress_bar.set_as_ratio(hp/mhp)
"

