[gd_scene load_steps=8 format=2]

[ext_resource path="res://assets/font_message.tres" type="DynamicFont" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

onready var node_quad = $Quad
onready var progress_bar = $Viewport/ProgressBar
var quad_mat
var fading = 0


func _ready():
	quad_mat = node_quad.get_surface_material(0)


func set(hp, mhp):
	progress_bar.set_as_ratio(hp/mhp)


func display(unit_name):
	$Viewport/Label.set_text(unit_name.capitalize())
	node_quad.show()
	quad_mat.albedo_color.a = 1
	fading = 4
	set_process(true)


func _process(delta):
	if fading < 0:
		quad_mat.albedo_color.a -= delta
		if quad_mat.albedo_color.a < 0:
			fading = 0
			node_quad.hide()
			set_process(false)
	else:
		fading -= delta
"

