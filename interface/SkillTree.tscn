[gd_scene load_steps=5 format=2]

[ext_resource path="res://assets/textures/rocky.png" type="Texture" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Panel

var learned

func _ready():
	learned = StyleBoxFlat.new()
	learned.set_bg_color(Color(.4, .4, .4))

	for child in $Skills.get_children():
		add_signals(child)

func add_signals(node):
	node.connect(\"toggled\", self, \"on_select\", [node])
	for child in node.get_children():
		add_signals(child)

func on_select(_toggle, node):
	node.disabled = true
	node.set(\"custom_styles/disabled\", learned)
	for child in node.get_children():
		child.show()
"

