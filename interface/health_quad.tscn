[gd_scene load_steps=6 format=2]

[ext_resource path="res://interface/health.tscn" type="PackedScene" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

onready var node_quad = $Quad
onready var healthbar = $Viewport/Health
var quad_mat
var fading = 0


func _ready():
	quad_mat = node_quad.get_surface_material(0)


func display(hp, mhp, display_name, level):
	healthbar.display(hp, mhp, display_name, level)
	fading = 4
	quad_mat.albedo_color.a = 1
	if !node_quad.visible:
		node_quad.show()
		set_process(true)


func _process(delta):
	if fading < 0:
		quad_mat.albedo_color.a -= delta
		if quad_mat.albedo_color.a < 0:
			fading = 0
			node_quad.hide()
			set_process(false)
	else:
		fading -= delta
"

