[sub_resource type="GDScript" id=1]
script/source = "extends Button


func set_reqs(reqs):
	var mana = reqs[0]
	var gold = reqs[1]
	if mana > 0 and gold > 0:
		$ManaAmount.set_text(str(mana))
		$GoldAmount.set_text(str(gold))
	elif mana > 0:
		$ManaAmount.set_text(str(mana))
		$GoldAmount.hide()
	elif gold > 0:
		$ManaAmount.hide()
		$GoldAmount.set_text(str(gold))
"

