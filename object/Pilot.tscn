[gd_scene load_steps=3 format=2]

[ext_resource path="res://object/Unit.tscn" type="PackedScene" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Node


onready var unit = $Unit
var interactions
var tasks = []
var task = [\"idle\", -1]
var task_timer = -1


func _ready():
	interactions = G.world

func set_task(newtask=[\"idle\", -1]):
	tasks = []
	task = newtask
	task_timer = task[1]

func set_tasks(newtasks):
	tasks = []
	for i in newtasks:
		add_task(i)
	next_task()

func add_task(newtask):
	tasks.insert(0, newtask)

func change_task(newtask):
	tasks.append(newtask)
	next_task()

func next_task():
	task = tasks.pop_back()
	if task == null:
		unit.state = \"move\"
		task = [\"idle\", -1]
		task_timer = -1
	else:
		task_timer = task[1]

func _physics_process(_delta):
	if task_timer == 0:
		if on_task_finish():
			next_task()
		else:
			return
	elif task_timer > 0:
		task_timer -= 1
		on_task_update()

func on_task_update():
	if task[0] == \"idle\":
		unit.state = \"move\"
	elif task[0] == \"wait\":
		unit.state = task[2]
	elif task[0] == \"work\":
		unit.state = \"work\"
	elif task[0] == \"drop\":
		unit.state = \"grab\"
	elif task[0] == \"interact\":
		unit.state = \"grab\"
	elif task[0] == \"grab\":
		unit.state = \"grab\"
	elif task[0] == \"attack\":
		unit.state = \"attack\"

func get_item(type):
	var items = G.world.get_items_at(unit.get_position())
	if !items.empty():
		for i in items:
			if type == i.type:
				return i

func get_object():
	var object = G.world.get_object_at(unit.get_position())
	if object != null:
		return object

func check_vacancy(x=0, y=2):
	var target_pos = unit.get_adjacent(x, y)
	return !G.world.get_tile_at(target_pos) and \\
		!G.world.get_item_at(target_pos) and \\
		!G.world.get_object_at(target_pos)


func on_task_finish():
	if task[0] == \"grab\":
		var item
		if len(task) > 2:
			item = task[2]
		else:
			item = get_item(\"item\")
		unit.set_weapon(item)
	elif task[0] == \"make\":
		G.make_and_add(task[2], unit.get_adjacent(0, 1))
	elif task[0] == \"find\":
		var item = G.item.make(task[2])
		unit.set_weapon(item)
	elif task[0] == \"gather\":
		G.add_resource(task[2][0], task[2][1], task[2][2])
	elif task[0] == \"damage\":
		task[2].damage(task[3])
	elif task[0] == \"interact\":
		var object = get_object()
		if !object:
			object = get_item(\"object\")
		interact(object)
		return false
	elif task[0] == \"work\":
		if task[2].work > 0:
			task[2].work -= 1
			task_timer = 50
			return false
	elif task[0] == \"drop\":
		unit.set_weapon(null)
	elif task[0] == \"spawn\":
		G.spawn_and_add(task[2], unit.get_adjacent(0, 1))
	elif task[0] == \"menu\":
		get_parent().ui.display(task[2], unit.get_adjacent(0, 1))
	unit.state = \"move\"
	return true


func interact(object):
	if object != null:
		if object is String:
			if object in G.item.interactions:
				set_tasks(G.item.interactions[object])
		elif object.interact:
			set_tasks(object.interact)
		else:
			change_task([\"grab\", 50, object])
		return true
"

[node name="Pilot" type="Spatial"]
script = SubResource( 1 )

