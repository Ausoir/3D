script/source = "extends MeshInstance


var frame = 0
var movement = Vector3()
var player
var material


func _ready():
	player = get_parent().get_node(\"Units/Player/Pilot/Unit\")
	material = get_surface_material(0)


func _physics_process(delta):
	transform.origin = player.transform.origin
	transform.origin.y = 5.9 + sin(frame*sin(delta)*30) * .12
	frame += delta
