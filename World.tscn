		tileset.find_item_by_name(\"mineral3\"),
		tileset.find_item_by_name(\"mineral4\"),
		tileset.find_item_by_name(\"mineral5\"),
		tileset.find_item_by_name(\"mineral6\"),
		tileset.find_item_by_name(\"mineral7\"),
		tileset.find_item_by_name(\"mineral8\"),
	], \"stump\": [
		tileset.find_item_by_name(\"stump\"),
	]
}

var rng


func make(item, x, y, z):
	if item == null:
		set_cell_item(x, y, z, -1)
	else:
		var items = models[item]
		set_cell_item(x, y, z, items[rng.randi_range(0, items.size()-1)], orientations[rng.randi_range(0, 3)])


func get_object_at(vec):
	var id = get_cell_item(vec.x, vec.y, vec.z)
	if id != -1:
		for i in models.keys():
			if id in models[i]:
				return i
	return null
"

