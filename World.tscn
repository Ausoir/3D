[sub_resource type="GDScript" id=9]
script/source = "extends WorldEnvironment


const SIDE = Vector3(0, 1, 0)
onready var light = $DirectionalLight
var sky
var frame = 0
var light_time = [
	Color(0, 0, 0),
	Color(.1, 0, .2),
	Color(1, .3, 0),
	Color(.9, .9, .9),
]


func _ready():
	sky = get_environment()
	light.rotate_x(-.8)

func _physics_process(delta):
	var tick = delta * .008
	light.rotate_x(-tick)
	light.translate(light.transform.basis.y)
	var sun_rot = -light.rotation.z #0 to PI
	if sun_rot > 0:
		#G.message(str(player.transform.basis.y) + \" \" + str(sun_rot))
		if sun_rot < .1:
			light.set_param(Light.PARAM_ENERGY, sun_rot)
			sky.background_energy = sun_rot * .1
			set_target_color(1, sun_rot * 10)
		elif sun_rot < .4:
			light.set_param(Light.PARAM_ENERGY, sun_rot)
			sky.background_energy = sun_rot * .1
			set_target_color(2, (sun_rot-.1) * 3.33)
		elif sun_rot < 1:
			light.set_param(Light.PARAM_ENERGY, sun_rot)
			if sky.background_energy < sun_rot:
				sky.background_energy *= 1.01
			set_target_color(3, sun_rot-.4)
		elif sun_rot > PI - .1:
			var value = PI - sun_rot # .1 to 0
			light.set_param(Light.PARAM_ENERGY, value)
			sky.background_energy = max(value * .1, 0)
			set_target_color(0, 1 - value * 10)
		elif sun_rot > PI - .4:
			var value = PI - sun_rot # .4 to .1
			light.set_param(Light.PARAM_ENERGY, value)
			sky.background_energy = value * .1
			set_target_color(2, 1 - (value-.1)*3.33)
		elif sun_rot > PI - 1:
			var value = PI - sun_rot # 1 to .4
			light.set_param(Light.PARAM_ENERGY, value)
			if sky.background_energy > value * .1:
				sky.background_energy *= .98


func set_target_color(target, weight):
	light.light_color = light.light_color.linear_interpolate(light_time[target], weight)
	sky.fog_color = light.light_color
"

