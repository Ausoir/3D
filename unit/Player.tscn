[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

# Constants
const GRAVITY = Vector3()
const CAMERA_X_ROT_MIN = -50
const CAMERA_X_ROT_MAX = 40

# Mouse sensitivity
export(float, 0.1, 1.0) var CAMERA_MOUSE_ROTATION_SPEED = 0.5

# Instances ref
onready var player_cam = $Camera
onready var unit = $Unit

# Variables (public members)
var mouse_motion = Vector2()
var mouse_captured = true


func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	var mat = load(\"res://assets/mat_dirt.tres\")
	unit.get_node(\"CharacterArmature/Skeleton/Body\").set_surface_material(2, mat)


func _input(event):
	if Input.is_action_just_pressed(\"restart\"):
		print(get_tree().reload_current_scene())
	elif Input.is_action_just_pressed(\"ui_fullscreen\"):
		OS.window_fullscreen = !OS.window_fullscreen
	elif Input.is_action_just_pressed(\"ui_mouse\"):  # Toggle mouse captured
		if mouse_captured:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			mouse_captured = false
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
			mouse_captured = true
			
	if event is InputEventMouseButton and event.button_index == BUTTON_LEFT and !mouse_captured:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		mouse_captured = true

	if event is InputEventMouseMotion:
		var rot = event.relative * CAMERA_MOUSE_ROTATION_SPEED
		player_cam.rotate_y(-rot.x)
		player_cam.orthonormalize()
		player_cam.rotation.x -= rot.y
		player_cam.rotation.x = clamp(player_cam.rotation.x, deg2rad(CAMERA_X_ROT_MIN), deg2rad(CAMERA_X_ROT_MAX))


func _physics_process(_delta):
	unit.motion_target = Vector2(
			Input.get_action_strength(\"move_left\") - Input.get_action_strength(\"move_right\"),
			Input.get_action_strength(\"move_front\") - Input.get_action_strength(\"move_back\")
		)
	if Input.is_action_just_pressed(\"jump\"):
		unit.state = \"jump\"
		unit.motion_target *= 16
		unit.velocity.y = 10
	#elif Input.is_action_just_pressed(\"interact\"):
	#	unit.state = \"grab\"
	elif Input.is_action_just_pressed(\"use\"):
		unit.state = \"work\"

	var camera_basis = player_cam.global_transform.basis
	var camera_z = camera_basis.z
	var camera_x = camera_basis.x

	camera_z.y = 0
	camera_x.y = 0
	unit.view_z = camera_z.normalized()
	unit.view_x = camera_x.normalized()
	unit.view_y = camera_basis.y.normalized()
	
	var unit_pos = unit.transform.origin
	var cam_pos = Vector2(unit_pos.x, unit_pos.z)
	cam_pos = cam_pos + Vector2(0, 2).rotated(-player_cam.rotation.y)
	player_cam.transform.origin.x = cam_pos.x
	player_cam.transform.origin.y = unit_pos.y - player_cam.rotation.x*3 + 2
	player_cam.transform.origin.z = cam_pos.y
	$Light.transform.origin = unit_pos
	
	unit.anim_tree[\"parameters/head_v/add_amount\"] = player_cam.rotation.x * -1.5 - .5
	
	check_interaction()


func check_interaction():
	pass
	#unit.global_transform.origin
"

[sub_resource type="GDScript" id=2]
script/source = "extends CanvasLayer


var on = false
var b_pos
var menubutton = preload(\"res://interface/button_craft.tscn\")
var item_list = preload(\"res://assets/data_items.gd\")
var unit


func toggle(arg, user):
	if !on:
		display(arg, user)
	else:
		clear()


func display(arg, user):
	set_offset(Vector2())
	on = true
	unit = user
	get_parent().enabled = false
	get_parent().get_node(\"sight\").set_color(Color(.3, .3, .3, 1))
	var globals = get_node(\"/root/globals\")
	$wood.set_amount(globals.resource[\"wood\"])
	$stone.set_amount(globals.resource[\"stone\"])
	$food.set_amount(globals.resource[\"food\"])
	$wood.show()
	$stone.show()
	$food.show()
	b_pos = Vector2()
	var items = globals.craftables[arg]
	for item in items:
		add_button(item)


func clear():
	set_offset(Vector2(0, -4000))
	var r = on
	on = false
	get_parent().enabled = true
	get_parent().get_node(\"sight\").set_color(Color(1, 1, 1, 1))
	for child in $buttons.get_children():
		$buttons.remove_child(child)
		child.queue_free()
	$message.set_text(\"\")
	return r


func add_button(arg):
	var button = menubutton.instance()
	var dict = item_list.items
	button.get_node(\"name\").set_text(arg.capitalize())
	var sprite = dict[arg]
	button.get_node(\"sprite\").region_rect = Rect2(sprite.x * 32, sprite.y * 32, 32, 32)
	button.set_reqs(sprite.req[1], sprite.req[2], sprite.req[3])
	$buttons.add_child(button)
	button.set_position(b_pos)
	button.connect(\"pressed\", self, \"button_pressed\", [arg, sprite.req])
	b_pos.y += 140


func button_pressed(arg, reqs):
	clear()
	var globals = get_node(\"/root/globals\")
	var feedback = globals.require_resource(reqs[1], reqs[2], reqs[3])
	if feedback == null:
		var newitem
		newitem = load(\"res://objects/object.tscn\").instance()
		newitem.make(\"site\", unit.position + Vector2(24, 0).rotated(unit.rotation))
		newitem.action = [\"craft\", arg]
		newitem.set_workload(reqs[0])
		newitem.interact(globals.younit)
		globals.world.get_node(\"Objects\").add_child(newitem)
		globals.factions[0].append(newitem)
	else:
		display_message(\"Not enough \" + feedback + \"!\")


func display_gather(wood, stone, food):
	$wood.hide()
	$stone.hide()
	$food.hide()
	var list = []
	if wood != 0:
		list.append([$wood, wood])
	if stone != 0:
		list.append([$stone, stone])
	if food != 0:
		list.append([$food, food])
	for res in list:
		res[0].show()
		if res[1] > 0:
			res[0].set_amount(\"+\" + str(res[1]))
		else:
			res[0].set_amount(str(res[1]))
	$popup.start(0)
	set_offset(Vector2())


func display_message(msg):
	$message.set_text(msg)
	$popup.start(0)
	set_offset(Vector2())


func _on_timer_timeout():
	clear()
	$popup.stop()
"

