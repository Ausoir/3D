[sub_resource type="GDScript" id=1]
script/source = "extends KinematicBody

const GRAVITY = Vector3(0, -40, 0)
export var move_speed: = 6
var anim_tree
var motion_target = Vector2()
var motion = Vector2()
var view_x = Vector3()
var view_y = Vector3()
var view_z = Vector3()
var orientation = Transform()
var velocity = Vector3()
var state = \"move\"
onready var helm = $Helm
onready var skeleton = $CharacterArmature/Skeleton
var head
var hand


func _ready():
	anim_tree = $AnimationTree
	orientation = global_transform
	orientation.origin = Vector3()
	head = skeleton.find_bone(\"Head\")
	hand = skeleton.find_bone(\"Fist.L\")


func _physics_process(delta):
	motion = motion.linear_interpolate(motion_target, 8 * delta)
	
	if is_on_floor():
		if velocity.y < -1:
			anim_tree[\"parameters/state/current\"] = 4
		elif state == \"jump\":
			state = \"move\"
			velocity.y = 24
			anim_tree[\"parameters/state/current\"] = 3
		elif state == \"grab\":
			anim_tree[\"parameters/state/current\"] = 1
		elif state == \"work\":
			anim_tree[\"parameters/state/current\"] = 2

	var target = motion.x * view_x + motion.y * view_z
	if target.length() > 0.001:
		var q_from = orientation.basis.get_rotation_quat()
		var q_to = Transform().looking_at(target, Vector3.UP).basis.get_rotation_quat()
		# Interpolate current rotation with desired one.
		orientation.basis = Basis(q_from.slerp(q_to, delta * 10))
		anim_tree[\"parameters/state/current\"] = 0
	var speed = max(abs(motion.x), abs(motion.y))
	anim_tree[\"parameters/movement/blend_position\"] = speed
	var rotdiff = orientation.basis.x.dot(view_z)
	anim_tree[\"parameters/head_h/add_amount\"] = rotdiff * 2
	
	var root_motion = anim_tree.get_root_motion_transform()
	orientation *= root_motion
	var root_velocity = orientation.origin / delta
	var h_velocity = Vector2(0, move_speed*speed).rotated(-orientation.basis.get_euler().y)
	velocity.x = h_velocity.x + root_velocity.x
	velocity.z = h_velocity.y + root_velocity.z
	velocity += GRAVITY * delta
	velocity = move_and_slide(velocity, Vector3.UP)

	orientation.origin = Vector3() # Clear accumulated root motion displacement (was applied to speed).
	orientation = orientation.orthonormalized() # Orthonormalize orientation.

	global_transform.basis = orientation.basis#.scaled(transform.basis.get_scale())
	update_equipment()


func set_skin(arg):
	$CharacterArmature/Skeleton/Body.set_material_override(arg)

func update_equipment():
	helm.transform = skeleton.get_bone_global_pose(head)
"

