[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Connectible.gd\"


func update_tiles():
	var face = global_transform.basis.z
	if abs(face.x) <= .7 and face.z < -.7:
		direction = 10
	elif face.x > .7 and abs(face.z) <= .7:
		direction = 16
	elif abs(face.x) <= .7 and face.z > .7:
		direction = 0
	elif face.x < -.7 and abs(face.z) <= .7:
		direction = 22
	tile_type = 980
	G.world.set_tile_at(translation, tile_type, direction)


func open_walls(_recurse=false):
	connection = 0
	tile_type = 980
	G.world.set_tile_at(translation, tile_type, direction)
"

