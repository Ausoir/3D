[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"

const Occupant_Display = preload(\"res://interface/occupant.tscn\")
var occupant
var occupant_name
var _onuse


func trigger(arg):
	if occupant == null:
		_onuse = onuse
		onuse = null
		var r = G.cmds([[\"v\",\"pos\"], [\"spawn\",arg], [\"claim\"]], self)
		occupant = r
		occupant_name = arg
		if progress_bar != null:
			progress_bar.queue_free()
		progress_bar = Occupant_Display.instance()
		progress_bar.label(arg.capitalize())
		add_child(progress_bar)

func on_hour(_hour):
	if occupant != null and !is_instance_valid(occupant):
		occupant = null
		occupant_name = null
		progress_bar.queue_free()
		progress_bar = null
		onuse = _onuse
"

