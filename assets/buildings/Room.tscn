[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Connectible.gd\"
const window = preload(\"res://assets/models/buildings/wallWindow.obj\")

func open_walls(recurse=true):
	if recurse:
		var pos = G.world.tilemap.world_to_map(transform.origin)
		var offset = G.dir_to_offset(direction, 0)
		if G.world.tilemap.get_cell_item(pos.x+offset.x,pos.y,pos.z+offset.y) != -1:
			if has_node(\"Door\") and is_instance_valid($Door) and has_node(\"WallB\") and is_instance_valid($WallB):
				$Door.mesh = $WallB.mesh
				$StaticBody/Door.shape = $StaticBody/Back.shape
		elif G.world.tilemap.get_cell_item(pos.x+offset.x,pos.y-1,pos.z+offset.y) == -1:
			if has_node(\"Door\") and is_instance_valid($Door):
				$Door.mesh = window
				$Door.create_trimesh_collision()
				$StaticBody/Door.shape = $Door.get_child(0).get_child(0).shape
				$Door.get_child(0).queue_free()
	.open_walls(recurse)
"

