[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Item.gd\"
const stages = [
	preload(\"res://assets/models/crops_cornStageA.obj\"),
	preload(\"res://assets/models/crops_cornStageB.obj\"),
	preload(\"res://assets/models/crops_cornStageC.obj\"),
	preload(\"res://assets/models/crops_cornStageD.obj\")
]
var stage = 0


func check_workdone():
	if progress_bar:
		var percentage = float(work_max - work) / work_max
		print(percentage)
		if percentage < .25:
			grow(0)
		elif percentage < .5:
			grow(1)
		elif percentage < .75:
			grow(2)
		else:
			grow(3)
	.check_workdone()


func grow(to):
	if to != stage:
		stage = to
		for child in $Corns.get_children():
			child.mesh = stages[stage]
"

