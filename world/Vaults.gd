func audit_vaults():
	for vault_type in data.keys():
		var vaults = data[vault_type]
		var index = 0
		for vault in vaults:
			audit_vault(vault, vault_type, index)
			index += 1

func audit_vault(vault, vault_type, index):
	var row = 0
	for rows in vault:
		var col = 0
		for cell in rows:
			if cell == 'D':
				if col % 2 == 1 or row % 2 == 1:
					push_error("Invalid vault at type:"+vault_type+" index:"+str(index))
					return false
			col += 1
		row += 1
	return true

func make_vault(rng, base, from, to, type="default"):
	var size = to - from
	var candidates = []
	from = Vector2(from.x + int(from.x)%2, from.y + int(from.y)%2)
	for vault in data[type]:
		var diffX = size.x - len(vault[0]) + 1
		var diffY = size.y - len(vault) + 1
		var diffX2 = size.x - len(vault) + 1
		var diffY2 = size.y - len(vault[0]) + 1
		if diffX == 0 and diffY == 0:
			candidates.append([vault, from.x, from.y, rng.randi_range(0, 3), false])
		elif diffX2 == 0 and diffY2 == 0:
			candidates.append([vault, from.x, from.y, rng.randi_range(0, 3), true])
		elif diffX >= 4 and diffY >= 4:
			var startX = from.x + rng.randi_range(1, floor((diffX-2)/2))*2
			var startY = from.y + rng.randi_range(1, floor((diffY-2)/2))*2
			candidates.append([vault, startX, startY, rng.randi_range(0, 3), false])
		elif diffX2 >= 4 and diffY2 >= 4:
			var startX = from.x + rng.randi_range(1, floor((diffX2-2)/2))*2
			var startY = from.y + rng.randi_range(1, floor((diffY2-2)/2))*2
			candidates.append([vault, startX, startY, rng.randi_range(0, 3), true])
	#print(size, " ", len(candidates), " ", from, " ", to)
	for candidate in candidates:
		if rng.randi_range(0, 1) == 0:
			place_vault(base, candidate[0], candidate[1], candidate[2], candidate[3], candidate[4])
			if candidate[4]:
				if candidate[3] == 1 or candidate[3] == 3:
					return 22
				else:
					return 16
			else:
				if candidate[3] == 2 or candidate[3] == 3:
					return 10
				else:
					return 0
	return -1

func place_vault(base, vault, startX, startY, flip, rot):
	if !check_vault_validity(vault):
		print("Invalid vault: " + str(vault))
	else:
		for y in range(len(vault)):
			for x in range(len(vault[0])):
				var sX = x
				var sY = y
				var fX
				var fY
				if flip == 1 or flip == 3:
					sX = (len(vault[0])-1 - x)
				if flip == 2 or flip == 3:
					sY = (len(vault)-1 - y)
				if rot:
					fX = startX + sY
					fY = startY + sX
				else:
					fX = startX + sX
					fY = startY + sY
				base[fY][fX] = vault[y][x]

func boundary_dist(vault, x, y):
	var xdist = min(x, len(vault[0])-1-x)
	var ydist = min(y, len(vault)-1-y)
	return min(xdist, ydist)

func check_vault_validity(vault):
	var sizeX = len(vault[0])
	for y in vault:
		if len(y) != sizeX:
			return false
	return true
