[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"


func open_walls():
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Barrel\")
	if G.world.rng.randi_range(0, 3) == 0:
		if rid(\"Barrel3\"):
			if G.world.rng.randi_range(0, 1) == 0:
				rid(\"Barrel2\")
	if G.world.rng.randi_range(0, 3) == 0:
		rid(\"Barrel4\")
	if G.world.rng.randi_range(0, 3) == 0:
		rid(\"Barrel5\")
"

