[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"


func open_walls():
	if G.world.rng.randi_range(0, 2) == 0:
		rid(\"Bench\")
	if G.world.rng.randi_range(0, 2) == 0:
		rid(\"Bench2\")
	if G.world.rng.randi_range(0, 2) == 0:
		rid(\"Bench3\")
	if G.world.rng.randi_range(0, 2) == 0:
		rid(\"Bench4\")
	for i in range(1, 9):
		if G.world.rng.randi_range(0, 1) == 0:
			rid(\"Plate\"+str(i))
"

