[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"


func open_walls():
	if G.world.rng.randi_range(0, 2) > 0:
		rid(\"Book\")
		if G.world.rng.randi_range(0, 2) > 0:
			rid(\"Lectern\")
	if is_instance_valid($Lectern):
		rid(\"Object1\")
		rid(\"Object2\")
		rid(\"Object3\")
		rid(\"Object4\")
		rid(\"Object5\")
		rid(\"Object7\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object6\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object8\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object9\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object10\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object11\")
"

