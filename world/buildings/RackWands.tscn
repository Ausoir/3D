script/source = "extends \"res://objects/Lootable.gd\"

func open_walls():
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object1\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object2\")

func trigger(arg):
	if is_instance_valid($Object1) or is_instance_valid($Object2):
		.trigger(arg)
		rid(\"Object1\")
		rid(\"Object2\")
"

