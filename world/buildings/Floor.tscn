[sub_resource type="GDScript" id=1]
script/source = "extends \"res://objects/Building.gd\"
const models = [
	preload(\"res://assets/models/buildings/floorDecoration_woodLeft.obj\"),
	preload(\"res://assets/models/buildings/floorDecoration_woodRight.obj\"),
]

func open_walls():
	for child in get_children():
		if G.world.rng.randi_range(0, 7) == 7:
			if G.world.rng.randi_range(0, 4) == 4:
				child.queue_free()
			else:
				child.mesh = G.world.rng.rand_arr(models)
"

