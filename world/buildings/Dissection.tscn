[sub_resource type="GDScript" id=48]
script/source = "extends \"res://objects/Building.gd\"


func open_walls():
	if G.world.rng.randi_range(0, 2) == 0:
		rid(\"Body\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Bone\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Bone2\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object1\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object2\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object3\")
	if G.world.rng.randi_range(0, 1) == 0:
		rid(\"Object4\")
"

