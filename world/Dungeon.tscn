[gd_scene load_steps=9 format=2]

[ext_resource path="res://objects/units/Player.tscn" type="PackedScene" id=1]
[ext_resource path="res://assets/meshlib_dungeon.tres" type="MeshLibrary" id=2]

[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

const DGenerator = preload(\"res://classes/DungeonGenerator.gd\")
const dungeon_types = {
	\"derelict\": [[\"defense\", \"living\", \"lab\", \"storage\"], [\"storage\"]]
}
onready var tilemap = $GridMap
onready var objects = $Objects
onready var others = $Others
onready var units = $Units

var rng = preload(\"res://classes/Random.gd\").new()
var map_size = Vector2(0, 0)
var pois = {\"torch\":[],
			\"camps\":[]}
var spawnpoints = []

var aggro_turn = 0


func _ready():
	G.initialize(self)
	generate(\"derelict\")
	G.world.get_node(\"WorldEnvironment\").environment.set_ambient_light_energy(0)


func generate(dungeon_type):
	rng.randomize()
	print(rand_seed(123))
	#rng.set_seed(21311)
	tilemap.rng = rng
	var dungeon_map
	map_size = Vector2(20, 20)
	$Ceiling.scale = Vector3(map_size.x*4, map_size.y*4, 1)
	$Ceiling.translation.x = map_size.x*2
	$Ceiling.translation.z = map_size.y*2
	var generator = DGenerator.new(rng, map_size)
	dungeon_map = generator.make_dungeon(4, 2)
	generator.make_rooms(dungeon_types[dungeon_type])
	dungeon_map = generator.make_border('W')

	for x in range(map_size.x):
		for z in range(map_size.y):
			var biome = dungeon_map[z][x]
			tilemap.set_cell_item(x, -1, z, tilemap.tileA)
			if biome == 'W' or biome == 'D' or biome == '#' or biome == 'S':
				tilemap.set_cell_item(x, 0, z, tilemap.tileB)
			elif biome == '^':
				tilemap.set_cell_item(x, -1, z, tilemap.spike)

	tilemap.autotile_map(Vector2.ZERO, map_size, 0)

	for x in range(map_size.x):
		for z in range(map_size.y):
			var biome = dungeon_map[z][x]
			var room_objects = generator.objects[z][x]
			if generator.biome[z][x] < .3 and x > 2 and x < map_size.x - 2 and z > 2 and z < map_size.y - 2:
				var pos = Vector3(x, 0, z)
				var vacant = true
				for xx in range(-1, 2):
					for zz in range(-1, 2):
						if tilemap.get_cell_item(x+xx,-1,z+zz) == 999:
							vacant = false
				if vacant:
					for xx in range(-1, 2):
						for zz in range(-1, 2):
							tilemap.set_cell_item(x+xx,-1,z+zz,999)
					if generator.biome[z][x] < .15:
						build(\"derelict floor2\", pos)
					else:
						build(\"derelict floor\", pos)
			if biome == 'D':
				var dir = tilemap.get_cell_item_orientation(x, 0, z)
				if x > 0 and x < map_size.x and z > 0 and z < map_size.y:
					if !((dir == 16 or dir == 22) and tilemap.get_cell_item(x,0,z-1)!=-1 and tilemap.get_cell_item(x,0,z+1)!=-1) and\\
						!((dir == 10 or dir == 0) and tilemap.get_cell_item(x-1,0,z)!=-1 and tilemap.get_cell_item(x+1,0,z)!=-1):
						pass
					elif (tilemap.get_cell_item(x-1,0,z)==-1 and tilemap.get_cell_item(x+1,0,z)==-1) or\\
						(tilemap.get_cell_item(x,0,z-1)==-1 and tilemap.get_cell_item(x,0,z+1)==-1):
						var fences = tilemap.fence_map.values()
						if tilemap.get_cell_item(x-1,0,z) in fences or\\
							tilemap.get_cell_item(x+1,0,z) in fences or\\
							tilemap.get_cell_item(x,0,z-1) in fences or\\
							tilemap.get_cell_item(x,0,z+1) in fences:
							tilemap.set_cell_item(x, 0, z, tilemap.fencedoor, dir)
						else:
							tilemap.set_cell_item(x, 0, z, tilemap.door, dir)
					else:
						tilemap.set_cell_item(x, 0, z, tilemap.door, dir)
						if dir == 16 or dir == 22:
							tilemap.set_cell_item(x+1, 0, z, -1)
							tilemap.set_cell_item(x-1, 0, z, -1)
						else:
							tilemap.set_cell_item(x, 0, z+1, -1)
							tilemap.set_cell_item(x, 0, z-1, -1)
						tilemap.autotile_map(Vector2(x-1,z-1), Vector2(x+1,z+1), 0)
				var pos = Vector3(x, 0, z)
				if !poi_near(pois.torch, pos, 5):
					pois.torch.append(pos)
					build(\"torch\", pos, dir)
			elif biome == '#':
				var tile = tilemap.get_cell_item(x,0,z)
				if tile in tilemap.fence_map:
					var fencetile = tilemap.fence_map[tile]
					var dir = tilemap.get_cell_item_orientation(x, 0, z)
					tilemap.set_cell_item(x,0,z,fencetile,dir)
			elif biome == 'f':
				build(\"campfire\", Vector3(x, 0, z))
			elif biome == 'S':
				build(\"scaffold\", Vector3(x, 0, z))
			elif biome == '?':
				build(\"chest\", Vector3(x, 0, z))
			elif biome == '!':
				spawn(\"warrior\", Vector3(x, 0, z))
			if room_objects != null:
				var pos = Vector3(x, 0, z)
				if room_objects[0] == \"torch\":
					if !poi_near(pois.torch, pos, 3):
						pois.torch.append(pos)
						build(\"torch\", pos, room_objects[1])
				else:
					build(room_objects[0], pos, room_objects[1])
	for room in generator.rooms:
		if room[0] == \"end\":
			for x in range(room[1].x, room[2].x+1):
				for z in range(room[1].y, room[2].y+1):
					tilemap.set_cell_item(x, -1, z, tilemap.tileB)
					if tilemap.get_cell_item(x, 0, z) == tilemap.door:
						spawnpoints.append(tilemap.map_to_world(x,5,z))

	if spawnpoints:
		var vec = spawnpoints.pop_front()
		var pos = tilemap.world_to_map(vec)
		if !poi_near(pois.torch, pos, 4):
			pois.torch.append(pos)
		$Units/Player/Pilot/Unit.transform.origin = vec
	else:
		$Units/Player/Pilot/Unit.transform.origin = Vector3(map_size.x*2, 45, map_size.y*2)


func generate_torches():
	var POI_DISTANCE = 6
	var gx = int(map_size.x / POI_DISTANCE)
	var gz = int(map_size.y / POI_DISTANCE)
	for x in range(gx):
		for z in range(gz):
			var ox = x * POI_DISTANCE + rng.randi_range(0, POI_DISTANCE-1)
			var oz = z * POI_DISTANCE + rng.randi_range(0, POI_DISTANCE-1)
			if tilemap.get_cell_item(ox, 0, oz) == tilemap.wall:
				var pos = Vector3(ox, 0, oz)
				if !poi_near(pois.torch, pos, 3):
					pois.torch.append(pos)

	for i in pois.torch:
		var dir = tilemap.get_cell_item_orientation(i.x, i.y, i.z)
		build(\"torch\", i, dir)


func poi_near(arr, pos, radius):
	var diffY = Vector3(1, 2, 1)
	for v in arr:
		if (v * diffY).distance_to(pos * diffY) < radius:
			return true
	return false

func spawn(unit, pos):
	var r = G.cmds([[\"t\", pos],[\"spawn\",unit]], null)

func build(building, pos, orientation=-1):
	if orientation == -1:
		orientation = [16,22,0,10][rng.randi_range(0, 3)]
	var vec = tilemap.map_to_world(pos.x,pos.y,pos.z)
	var ortho = G.dir_to_offset(orientation, 0)
	var t = Transform().translated(vec).looking_at(vec+Vector3(ortho.x, 0, ortho.y), Vector3.UP)
	var r = G.cmds([[\"t\", t],[\"make\",building]], null)
	return r


func is_tile_at(vec, tilename):
	return tilemap.is_tile_named(get_tile_at(vec), tilename)


func get_tile_at(vec):
	var pos = tilemap.world_to_map(vec)# + Vector3(0, 1, 0))
	return tilemap.get_cell_item(pos.x, pos.y, pos.z)


func set_tile_at(vec, tilename, orientation=-1, autotile=false):
	var pos = tilemap.world_to_map(vec)# + Vector3(0, 1, 0))
	var tile
	if tilename is String:
		tile = tilemap.tileset.find_item_by_name(tilename)
	else:
		tile = tilename
	if orientation == -1:
		orientation = tilemap.get_cell_item_orientation(pos.x,pos.y,pos.z)
	tilemap.set_cell_item(pos.x, pos.y, pos.z, tile, orientation)
	if autotile:
		tilemap.autotile_map(Vector2(pos.x-1, pos.z-1), Vector2(pos.x+1, pos.z+1), 0)


func snap_to_tile(vec):
	var r = tilemap.world_to_map(vec)
	return tilemap.map_to_world(r.x, r.y, r.z)


func get_units_near(vec, radius=2):
	var r = []
	for i in units.get_children():
		if (i.global_transform.origin - vec).length() <= radius:
			r.append(i)
	return r


func get_items_at(vec, radius=1.5):
	var r = []
	for i in objects.get_children():
		if (i.transform.origin - vec).length() <= radius:
			r.append(i)
	return r

func get_item_type_at(type, vec, radius=2):
	var items = G.world.get_items_at(vec, radius)
	if !items.empty():
		for i in items:
			if type == i.item_type:
				return i


func get_pos(vec):
	return tilemap.map_to_world(vec.x, vec.y+.5, vec.z)
"

[sub_resource type="GDScript" id=2]
script/source = "extends GridMap

const orientations = [0, 10, 16, 22]#Z-,Z+,X-,X+

const autotile_dict = [
	[[1, 3, 5, -7], [1, -3, 5, 7], [1, 3, -5, 7], [-1, 3, 5, 7]],
	[[1, -3, 5, 7], [1, 3, 5, -7], [-1, 3, 5, 7], [1, 3, -5, 7]],
	[[1, -3, 5, -7], [1, -3, 5, -7], [-1, 3, -5, 7], [-1, 3, -5, 7]],
	[[-1, 3, 5, -7], [1, -3, -5, 7], [1, 3, -5, -7], [-1, -3, 5, 7]],
	[[-1, -3, 5, -7], [1, -3, -5, -7], [-1, 3, -5, -7], [-1, -3, -5, 7]],
	[[1, 3, 5, 7]],
	[[-1, -3, -5, -7]],
]
var tileset = preload(\"res://assets/meshlib_dungeon.tres\")
var tileA = tileset.find_item_by_name(\"tile1\")
var tileB = tileset.find_item_by_name(\"tile2\")
var door = tileset.find_item_by_name(\"door\")
var wall = tileset.find_item_by_name(\"wall1\")
var wallend2 = tileset.find_item_by_name(\"wallend2\")
var wallcorner = tileset.find_item_by_name(\"wallcorner\")
var spike = tileset.find_item_by_name(\"spike\")
var fence = tileset.find_item_by_name(\"fence\")
var fencecorner = tileset.find_item_by_name(\"fencecorner\")
var fencedoor = tileset.find_item_by_name(\"fencedoor\")
var walls = [
	tileset.find_item_by_name(\"wallsplit\"),
	wall,
	wall,
	wallcorner,
	tileset.find_item_by_name(\"wallend1\"),
	tileset.find_item_by_name(\"wallcross\"),
	tileset.find_item_by_name(\"wallsingle\"),
]
var fence_map = {
	wall: fence,
	wallcorner: fencecorner,
	door: fencedoor
}

var rng

func is_landable(tile):
	return tile != -1

func is_climbable(_tile):
	return false

func is_wall(tile):
	return tile != -1

func is_tunnel(tile):
	return tile == door

func is_tile_named(tile, tilename):
	return tile == tileset.find_item_by_name(tilename)

func autotile_map(from, to, y):
	var item
	var autotiles = []
	var autotile
	for x in range(from.x, to.x):
		for z in range(from.y, to.y):
			item = get_cell_item(x, y, z)
			if item == tileB:
				autotile = set_autotile(tileB, x, y, z, autotile_dict)
				if autotile:
					autotiles.append(autotile)
	for cell in autotiles:
		set_cell_item(cell[0], cell[1], cell[2], walls[cell[3]], orientations[cell[4]])

func set_autotile(compare, x, y, z, dict):
	var adj = [-1, -2, -3, -4, -5, -6, -7, -8]
	if get_cell_item(x+1, y, z) == compare:
		adj[0] *= -1
	if get_cell_item(x+1, y, z+1) == compare:
		adj[1] *= -1
	if get_cell_item(x, y, z+1) == compare:
		adj[2] *= -1
	if get_cell_item(x-1, y, z+1) == compare:
		adj[3] *= -1
	if get_cell_item(x-1, y, z) == compare:
		adj[4] *= -1
	if get_cell_item(x-1, y, z-1) == compare:
		adj[5] *= -1
	if get_cell_item(x, y, z-1) == compare:
		adj[6] *= -1
	if get_cell_item(x+1, y, z-1) == compare:
		adj[7] *= -1
	var count = 0
	var orientation
	for v in dict:
		orientation = 0
		for sidereqs in v:
			if is_matching(adj, sidereqs):
				return [x, y, z, count, orientation]
			orientation += 1
		count += 1

func is_matching(adj, req):
	for side in req:
		if adj[abs(side)-1] != side:
			return false
	return true
"

