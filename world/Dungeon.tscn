[sub_resource type="GDScript" id=1]
script/source = "extends Spatial

const WALLTILES = ['W', '#']
const SEMIWALLTILES = ['W', '#', 'D', '=']
const OPENTILES = ['.', ',']
const DGenerator = preload(\"res://world/DungeonGenerator.gd\")
const Levels = preload(\"res://world/Levels.gd\")
const Autotile = preload(\"res://world/Autotile.gd\")
onready var tilemap = $GridMap
onready var objects = $Objects
onready var others = $Others
onready var units = $Units
onready var players = $Players

var rng = preload(\"res://classes/Random.gd\").new()
var map_size
var dungeon_map
var spawnpoints = []
var spawnpoints_enemy = []
var torchs = []


func _ready():
	G.initialize(self)
	G.world.get_node(\"WorldEnvironment\").environment.set_ambient_light_energy(0)
	G.level = Levels.new(6)
	generate(G.level)
	add_player()

func add_player():
	var unit = G.cmds([[\"make\",\"dummy\"]], null)
	var player = preload(\"res://objects/units/Player.tscn\").instance()
	unit.transform.origin = get_spawnpoint()
	player.assign(unit)
	$Players.add_child(player)

func generate(level):
	var current_level = level.get_dungeon()
	rng.randomize()
	var seeed = rng.randi_range(1, 999999)
#	seeed = 70277
	print(seeed)
	rng.set_seed(seeed)
	tilemap.rng = rng
	map_size = current_level[0]
	$Ceiling.scale = Vector3(map_size.x*4, 1, map_size.y*4)
	$Floor.scale = Vector3(map_size.x*4, 1, map_size.y*4)
	$Ceiling.translation.x = map_size.x*2
	$Ceiling.translation.z = map_size.y*2
	$Floor.translation.x = map_size.x*2
	$Floor.translation.z = map_size.y*2
	var generator = DGenerator.new(rng, map_size)
	dungeon_map = generator.make_dungeon(current_level[1][0], current_level[1][1])
	dungeon_map = generator.make_border('W')
	generator.make_rooms(current_level[2])
	print(dungeon_map)
	dungeon_map = generator.make_border('W', ['#', '='])
	Autotile.new(tilemap, dungeon_map).autotile()

	var mob_num = clamp(floor(map_size.x * map_size.y * .01), 2, 16)
	for x in range(0,map_size.x+1):
		for z in range(0,map_size.y+1):
			var isOdd = x % 2 == 1 or z % 2 == 1
			var terrain = dungeon_map[z][x]
			var hx = x*.5
			var hz = z*.5
			var room_objects = generator.dungeon_objects[z][x]
			var room_floors = generator.dungeon_floors[z][x]
			var dir = tilemap.get_cell_item_orientation(hx, 0, hz)
			var tile = tilemap.get_cell_item(hx,0,hz)
			if terrain == '@':
				spawnpoints.append(Vector3(hx, 0, hz))
			if !isOdd:
				if generator.biome[z][x] < .3:
					if x > 2 and x < map_size.x - 2 and z > 2 and z < map_size.y - 2:
						var vacant = true
						for xx in range(-1, 2):
							for zz in range(-1, 2):
								if tilemap.get_cell_item(hx+xx,-1,hz+zz) == 999:
									vacant = false
						if vacant:
							for xx in range(-1, 2):
								for zz in range(-1, 2):
									tilemap.set_cell_item(hx+xx,-1,hz+zz,999)
							if generator.biome[z][x] < .15:
								build(\"derelict floor2\", Vector3(hx, 0, hz))
							else:
								build(\"derelict floor\", Vector3(hx, 0, hz))
					if tile==tilemap.wallsingle:
						tilemap.set_cell_item(hx,0,hz,tilemap.wallsingle2,dir)
					elif tile==tilemap.wallend:
						tilemap.set_cell_item(hx,0,hz,tilemap.wallend2,dir)
				elif generator.biome[z][x] > .7:
					if tile==tilemap.wall:
						if generator.biome[z][x] > .8:
							tilemap.set_cell_item(hx,0,hz,tilemap.wall2,dir)
						elif generator.biome[z][x] > .75:
							tilemap.set_cell_item(hx,0,hz,tilemap.wall3,dir)
				elif terrain == '?':
					build(\"treasure\", Vector3(hx, 0, hz))
				elif tile == tilemap.door or tile == tilemap.fencedoor:
					if x > 1 and z > 1 and x < map_size.x-1 and z < map_size.y-1:
						var pos = Vector3(hx, 0, hz)
						if !poi_near(torchs, pos, 5):
							torchs.append(pos)
							build(\"walltorch\", pos, dir)
				if tilemap.get_cell_item(hx, -1, hz) == -1:
					tilemap.set_cell_item(hx, -1, hz, tilemap.tileA)
			if room_floors != null:
				if room_floors == \"planks\":
					var plank = build(room_floors, Vector3(hx, 0, hz), 0)
					plank.trigger(generator.biome[z][x] * 50)
				else:
					build(room_floors, Vector3(hx, 0, hz), 0)
			if generator.biome[z][x] < .3 and terrain == 'W' and rng.randi_range(0, 3) == 0:
				build(\"scaffold\", Vector3(hx, 0, hz))
			elif room_objects != null:
				var pos = Vector3(hx, 0, hz)
				if room_objects[0] == \"torch\":
					torchs.append(pos)
					build(\"walltorch\", pos, room_objects[1])
				elif room_objects[0] == \"mob\":
					spawnpoints_enemy.append(tilemap.map_to_world(hx, 1, hz))
				elif room_objects[0] == \"door\":
					var door = build(\"door\", pos, room_objects[1])
					if tile == tilemap.fencedoor:
						door.to_fence()
				else:
					build(room_objects[0], pos, room_objects[1])
	while mob_num > 0:
		mob_num -= 1
		spawn(rng.rand_arr(spawnpoints_enemy))

func get_spawnpoint():
	var t = rng.rand_arr(spawnpoints)
	if t == null:
		t = Vector3(.5, 0, .5)
	build(\"portal\", t, 0)
	return t * tilemap.cell_size + Vector3(2,2,2)

func poi_near(arr, pos, radius):
	var diffY = Vector3(1, 2, 1)
	for v in arr:
		if (v * diffY).distance_to(pos * diffY) < radius:
			return true
	return false

func spawn(pos):
#	for _i in range(1, rng.randi_range(1, 3)):
	var unit = G.level.get_loot(\"mobs\")
	var t = pos + Vector3(rng.randf_range(-1, 1), 0, rng.randf_range(-1, 1))
	G.cmds([[\"t\", t],[\"make\",unit],[\"rotate\"]], null)

func build(building, pos, orientation=-1):
	if orientation == -1:
		orientation = [16,22,0,10][rng.randi_range(0, 3)]
	var vec = pos * tilemap.cell_size + Vector3(2,2,2)
	var ortho = G.dir_to_offset(orientation, 0)
	var t = Transform().translated(vec)
	if ortho != Vector2.ZERO:
		t = t.looking_at(vec+Vector3(ortho.x, 0, ortho.y), Vector3.UP)
	var r = G.cmds([[\"t\", t],[\"make\",building]], null)
	return r

func is_tile_at(vec, tilename):
	return tilemap.is_tile_named(get_tile_at(vec), tilename)

func get_tile_at(vec):
	var pos = tilemap.world_to_map(vec)# + Vector3(0, 1, 0))
	return tilemap.get_cell_item(pos.x, pos.y, pos.z)

func set_tile_at(vec, tilename, orientation=-1, autotile=false):
	var pos = tilemap.world_to_map(vec)# + Vector3(0, 1, 0))
	var tile
	if tilename is String:
		tile = tilemap.tileset.find_item_by_name(tilename)
	else:
		tile = tilename
	if orientation == -1:
		orientation = tilemap.get_cell_item_orientation(pos.x,pos.y,pos.z)
	tilemap.set_cell_item(pos.x, pos.y, pos.z, tile, orientation)
	if autotile:
		tilemap.autotile_map_simple(Vector2(pos.x-1, pos.z-1), Vector2(pos.x+1, pos.z+1), 0)

func snap_to_tile(vec):
	var r = tilemap.world_to_map(vec)
	return tilemap.map_to_world(r.x, r.y, r.z)

func get_units_near(vec, radius=2):
	var r = []
	for i in units.get_children():
		if (i.global_transform.origin - vec).length() <= radius:
			r.append(i)
	return r

func get_items_at(vec, radius=1.5):
	var r = []
	for i in objects.get_children():
		if (i.transform.origin - vec).length() <= radius:
			r.append(i)
	return r

func get_item_type_at(type, vec, radius=2):
	var items = G.world.get_items_at(vec, radius)
	if !items.empty():
		for i in items:
			if type == i.item_type:
				return i

func get_pos(vec):
	return tilemap.map_to_world(vec.x, vec.y+.5, vec.z)
"

[sub_resource type="GDScript" id=2]
script/source = "extends GridMap

const tileset = preload(\"res://assets/meshlib_dungeon.tres\")
const orientations = [0, 10, 16, 22]#Z-,Z+,X-,X+
const wall_autotile_map = [
	[[1, 3, 5, -7], [1, -3, 5, 7], [1, 3, -5, 7], [-1, 3, 5, 7]],
	[[1, -3, 5, 7], [1, 3, 5, -7], [-1, 3, 5, 7], [1, 3, -5, 7]],
	[[1, -3, 5, -7], [1, -3, 5, -7], [-1, 3, -5, 7], [-1, 3, -5, 7]],
	[[-1, 3, 5, -7], [1, -3, -5, 7], [1, 3, -5, -7], [-1, -3, 5, 7]],
	[[-1, -3, 5, -7], [1, -3, -5, -7], [-1, 3, -5, -7], [-1, -3, -5, 7]],
	[[1, 3, 5, 7]],
	[[-1, -3, -5, -7]],
]
var tileA = tileset.find_item_by_name(\"tile1\")
var tileB = tileset.find_item_by_name(\"tile2\")
var door = tileset.find_item_by_name(\"door\")
var window = tileset.find_item_by_name(\"window1\")
var wall = tileset.find_item_by_name(\"wall1\")
var wall2 = tileset.find_item_by_name(\"wall2\")
var wall3 = tileset.find_item_by_name(\"wall3\")
var wallend = tileset.find_item_by_name(\"wallend1\")
var wallend2 = tileset.find_item_by_name(\"wallend2\")
var wallcorner = tileset.find_item_by_name(\"wallcorner\")
var wallsingle = tileset.find_item_by_name(\"wallsingle1\")
var wallsingle2 = tileset.find_item_by_name(\"wallsingle2\")
var wallsplit = tileset.find_item_by_name(\"wallsplit\")
var wallcross = tileset.find_item_by_name(\"wallcross\")
var spike = tileset.find_item_by_name(\"spike\")
var fence = tileset.find_item_by_name(\"fence\")
var fencecorner = tileset.find_item_by_name(\"fencecorner\")
var fencedoor = tileset.find_item_by_name(\"fencedoor\")
var fencewindow = tileset.find_item_by_name(\"window2\")
var walls = [
	wallsplit,
	wall,
	wall,
	wallcorner,
	wallend,
	wallcross,
	wallsingle,
]
var doors = [
	wallsplit,
	door,
	door,
	wallcorner,
	wallend,
	wallcross,
	wallsingle
]
var windows = [
	wallsplit,
	window,
	window,
	wallcorner,
	wallend,
	wallcross,
	wallsingle
]
var fence_map = {
	wall: fence,
	wallcorner: fencecorner,
	door: fencedoor,
	window: fencewindow,
}

var rng

func is_tile_named(tile, tilename):
	return tile == tileset.find_item_by_name(tilename)

func make_map(map, from, to):
	for x in range(from.x, to.x+1):
		for z in range(from.y, to.y+1):
			var biome = map[z][x]
			set_cell_item(x, -1, z, tileA)
			if biome == 'W' or biome == '#':
				set_cell_item(x, 0, z, wall)
			elif biome == '=':
				set_cell_item(x, 0, z, window)
			elif biome == 'D':
				set_cell_item(x, 0, z, door)
			elif biome == '^':
				set_cell_item(x, -1, z, spike)
				G.world.make_occluder(x, 0, z)

func autotile_map(from, to, y, is_border=false):
	var item
	var wall_autotiles = []
	var door_autotiles = []
	var window_autotiles = []
	var autotile
	for x in range(from.x, to.x+1):
		for z in range(from.y, to.y+1):
			item = get_cell_item(x, y, z)
			if item == door:
				autotile = set_autotile(x, y, z, wall_autotile_map)
				if autotile:
					door_autotiles.append(autotile)
			elif item == window:
				autotile = set_autotile(x, y, z, wall_autotile_map)
				if autotile:
					window_autotiles.append(autotile)
			elif item == wall:
				autotile = set_autotile(x, y, z, wall_autotile_map)
				if autotile:
					wall_autotiles.append(autotile)
	var updated_autotiles = []
	var update_autotiles = []
	for cell in wall_autotiles:
		set_cell_item(cell[0], cell[1], cell[2], walls[cell[3]], orientations[cell[4]])
	for cell in door_autotiles:
		var dir = orientations[cell[4]]
		var doortile = doors[cell[3]]
		var x = cell[0]
		var z = cell[2]
		if doortile == wallsplit or doortile == wallcross:
			print(doortile,\" split at \",x,\",\",z)
			set_cell_item(x,cell[1],z,door,dir)
			if dir == 0:
				if get_cell_item(x,cell[1],z+2) in walls:
					updated_autotiles.append([x,cell[1],z+1,wallend,16])
				else:
					updated_autotiles.append([x,cell[1],z+1,-1,-1])
				update_autotiles.append([Vector2(x-1,z+1), Vector2(x+1,z+2)])
			elif dir == 10:
				if get_cell_item(x,cell[1],z-2) in walls:
					updated_autotiles.append([x,cell[1],z-1,wallend,22])
				else:
					updated_autotiles.append([x,cell[1],z-1,-1,-1])
				update_autotiles.append([Vector2(x-1,z-2), Vector2(x+1,z-1)])
			elif dir == 16:
				if get_cell_item(x+2,cell[1],z) in walls:
					updated_autotiles.append([x+1,cell[1],z,wallend,10])
				else:
					updated_autotiles.append([x+1,cell[1],z,-1,-1])
				update_autotiles.append([Vector2(x+1,z-1), Vector2(x+2,z+1)])
			elif dir == 22:
				if get_cell_item(x-2,cell[1],z) in walls:
					updated_autotiles.append([x-1,cell[1],z,wallend,0])
				else:
					updated_autotiles.append([x-1,cell[1],z,-1,-1])
				update_autotiles.append([Vector2(x-2,z-1), Vector2(x-1,z+1)])
		elif doortile == wallcorner:
			updated_autotiles.append([x,cell[1],z,wallcorner,dir])
			if dir == 0:
				updated_autotiles.append([x-1,cell[1],z,door,0])
				updated_autotiles.append([x,cell[1],z+1,door,22])
			elif dir == 10:
				updated_autotiles.append([x+1,cell[1],z,door,10])
				updated_autotiles.append([x,cell[1],z-1,door,16])
			elif dir == 16:
				updated_autotiles.append([x+1,cell[1],z,door,0])
				updated_autotiles.append([x,cell[1],z+1,door,16])
			elif dir == 22:
				updated_autotiles.append([x-1,cell[1],z,door,10])
				updated_autotiles.append([x,cell[1],z-1,door,22])
		else:
			set_cell_item(cell[0], cell[1], cell[2], doors[cell[3]], dir)
	for cell in window_autotiles:
		set_cell_item(cell[0], cell[1], cell[2], windows[cell[3]], orientations[cell[4]])
	for cell in updated_autotiles:
		if cell[3] == -1 and is_border:
			if cell[0] == 0 or cell[0] == to.x:
				set_cell_item(cell[0], cell[1], cell[2], wall, 16)
				continue
			elif cell[2] == 0 or cell[2] == to.y:
				set_cell_item(cell[0], cell[1], cell[2], wall, 0)
				continue
		set_cell_item(cell[0], cell[1], cell[2], cell[3], cell[4])
	for bounds in update_autotiles:
		autotile_map_simple(bounds[0], bounds[1], y)

func autotile_map_simple(from, to, y):
	var item
	var autotiles = []
	var autotile
	for x in range(from.x, to.x+1):
		for z in range(from.y, to.y+1):
			item = get_cell_item(x, y, z)
			if item == wallsplit or item == wallcorner:
				autotile = set_autotile(x, y, z, wall_autotile_map)
				if autotile:
					autotiles.append(autotile)
	for cell in autotiles:
		set_cell_item(cell[0], cell[1], cell[2], walls[cell[3]], orientations[cell[4]])

func set_autotile(x, y, z, dict):
	var adj = [-1, -2, -3, -4, -5, -6, -7, -8]
	if get_cell_item(x+1, y, z) != -1:
		adj[0] *= -1
	if get_cell_item(x+1, y, z+1) != -1:
		adj[1] *= -1
	if get_cell_item(x, y, z+1) != -1:
		adj[2] *= -1
	if get_cell_item(x-1, y, z+1) != -1:
		adj[3] *= -1
	if get_cell_item(x-1, y, z) != -1:
		adj[4] *= -1
	if get_cell_item(x-1, y, z-1) != -1:
		adj[5] *= -1
	if get_cell_item(x, y, z-1) != -1:
		adj[6] *= -1
	if get_cell_item(x+1, y, z-1) != -1:
		adj[7] *= -1
	var count = 0
	var orientation
	for v in dict:
		orientation = 0
		for sidereqs in v:
			if is_matching(adj, sidereqs):
				return [x, y, z, count, orientation]
			orientation += 1
		count += 1

func is_matching(adj, req):
	for side in req:
		if adj[abs(side)-1] != side:
			return false
	return true
"

